# Git's attribute configuration is source text on every host, including
# repositories used to verify byte-preserved fixtures with autocrlf=false.
/.gitattributes text eol=lf

# Hook scripts must stay LF on every platform: a CRLF shebang line
# (#!/usr/bin/env bash\r) breaks git's hook spawn on Windows
# ("cannot spawn .githooks/pre-push: No such file or directory").
/.githooks/** text eol=lf
/tests/golden/source_v2/*.json text eol=lf
/tests/fixtures/narrative_transport_v1/*.json text eol=lf

# Native test receipts are byte evidence, not formatted source. Preserve their
# declared SHA through staging/checkout; CR/CRLF from Windows subprocess logs
# must not become whitespace defects or silently normalized bytes.
/docs/plans/**/*.log -text -diff
/docs/plans/**/evidence/** -text -diff
/tests/fixtures/narrative_real_transcript/*.txt -text -diff

# This real-run phase records native observations with declared byte hashes.
/docs/plans/cross-market-rf-e2e-2026-10-08/phase6/post_w03_original_research_2026-10-11/**/*.json -text
/docs/plans/cross-market-rf-e2e-2026-10-08/phase6/post_w03_original_research_2026-10-11/ci-docx-investigation/** -text

# This sealed expert package declares SHA for every byte of its plan artifacts.
# Shared implementation progress stays outside the sealed package files.
/docs/plans/cross-market-rf-e2e-2026-10-08/phase6/w04_post_pw03_common_roots_2026-10-11/** -text -diff

# Exact W04 reviewed source bytes. Other runtime files keep their existing rules.
/src/company_wiki/automation/narrative_evidence_view.py -text -eol
/src/company_wiki/automation/narrative_transport.py -text -eol
/src/company_wiki/automation/narrative_transport_contracts.py -text -eol
/src/company_wiki/narrative_subject.py -text -eol
/src/company_wiki/source_catalog/document_kinds.py -text -eol
/src/company_wiki/source_catalog/narrative_transport_cli.py -text -eol
/src/company_wiki/source_catalog/source_reader.py -text -eol
/tests/unit/test_w04_source_transport.py -text -eol

# ROOT reception evidence and W07 fixed input references must retain byte hashes.
/.planning/w04-root-novelty-recall/phase2-independent/** -text -diff
/.planning/w04-selector-integration/** -text -diff
/.planning/w06-cross-period-acquisition/cutoff-implementation/** -text -diff
/.planning/w06-cross-period-acquisition/cutoff-independent/retest/** -text -diff
/.planning/w07-parallel-packages/** -text -diff

# Exact ROOT W04 integration receipts.
/.planning/w04-selector-reception/** -text -diff

# Retained native observations carry byte hashes in plan fixture manifests.
# Preserve their original bytes through Git filters and cross-platform checkout.
/docs/plans/**/fixtures/** -text -diff -eol
/docs/plans/**/results/** -text -diff -eol
/docs/plans/**/receipts/** -text -diff -eol

# DU-BENCH gold/manifest JSON must roundtrip byte-identically through
# add->blob->checkout on every platform (tests hash the git-normalized LF
# content); same pattern as /tests/golden/source_v2/*.json above.
/tools/document_understanding_benchmark/*.json text eol=lf
/tools/document_understanding_benchmark/gold/*.json text eol=lf
/tools/document_understanding_benchmark/reviews/*.json text eol=lf
