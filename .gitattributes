# Hook scripts must stay LF on every platform: a CRLF shebang line
# (#!/usr/bin/env bash\r) breaks git's hook spawn on Windows
# ("cannot spawn .githooks/pre-push: No such file or directory").
/.githooks/** text eol=lf
/tests/golden/source_v2/*.json text eol=lf
/tests/fixtures/narrative_transport_v1/*.json text eol=lf

# Native test receipts are byte evidence, not formatted source. Preserve their
# declared SHA through staging/checkout; CR/CRLF from Windows subprocess logs
# must not become whitespace defects or silently normalized bytes.
/docs/plans/**/*.log -text -diff
/docs/plans/**/evidence/** -text -diff
/tests/fixtures/narrative_real_transcript/*.txt -text -diff
