# 公司知识库环境变量配置
# 复制此文件为 .env 并填入实际值

# Tavily 搜索 API
TAVILY_API_KEY=your_tavily_api_key_here

# MiniMax-M3 主 LLM（必需；仅放环境变量）
MINIMAX_API_KEY=your_minimax_api_key_here

# MiMo 2.5 Pro 通用次 LLM（可选）
MIMO_API_KEY=your_mimo_api_key_here

# 旧 provider 兼容（只有显式选择相应 provider 时才读取）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Wiki 根目录（可选，默认为 ~/company-wiki）
# WIKI_ROOT=~/company-wiki

# 日志级别（可选，默认为 INFO）
# LOG_LEVEL=INFO

# Legacy writer 放行（Phase 11 安全冻结后，临时启用旧版写入脚本）
# COMPANY_WIKI_LEGACY_WRITERS=allow
