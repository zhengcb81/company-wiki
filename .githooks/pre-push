#!/bin/sh
# Pre-push gate: run only the small reader/regression smoke set. The complete
# Unit + portable Contract suites run once in GitHub Actions after push.
#
# Installed as .githooks/pre-push (git config core.hooksPath .githooks).
# Keep push latency short; the full seven-stage local gate remains available
# explicitly via `python tools/pre_push_gate.py` when a broad local run is needed.
#
# NOTE: shebang MUST be #!/bin/sh (git-for-windows spawns /bin/sh hooks
# natively; /usr/bin/env bash failed with "cannot spawn").  Use
# `python`, not python3, on Windows.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$ROOT/tools/pre_push_gate.py" ]; then
  echo "pre-push gate: tools/pre_push_gate.py missing - skipping" >&2
  exit 0
fi

python "$ROOT/tools/pre_push_gate.py" --metadata-reader-contracts-only
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "PUSH BLOCKED by pre-push gate (CI root-fix protocol). Fix the root cause; do not bypass." >&2
fi
exit "$rc"
