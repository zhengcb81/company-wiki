#!/bin/sh
# Daily code pushes run the fixed CI contract smoke once. Proven documentation
# changes start no pytest process. Change-specific tests are run by the author;
# full Unit/Contract and end-to-end acceptance belong to CI and major nodes.
# A green push is local_fast_pass for the fixed smoke, not the whole project.
#
# Installed as .githooks/pre-push (git config core.hooksPath .githooks).
# Full local validation remains explicit: python tools/pre_push_gate.py
#
# git-for-windows requires this /bin/sh shebang; use python, not python3.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$ROOT/tools/pre_push_gate.py" ]; then
  echo "pre-push gate: tools/pre_push_gate.py missing - cannot validate this push" >&2
  exit 1
fi

python "$ROOT/tools/pre_push_gate.py" --push-checks
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "PUSH BLOCKED by pre-push gate (CI root-fix protocol). Fix the root cause; do not bypass." >&2
fi
exit "$rc"
