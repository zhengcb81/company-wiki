{
  "schema_version": "du2-family-spec/1",
  "id": "administrative_document",
  "version": "1.0.0",
  "applies_to": {
    "regimes": ["cn_exchange", "hkex", "sec", "other", "unknown"],
    "forms": [],
    "family": "administrative",
    "purposes": ["administrative_check"],
    "modifiers": {"extent": "unknown", "revision": "unknown"},
    "carrier": ["pdf", "image", "html"],
    "language": ["zh", "en"]
  },
  "recognition": {
    "positive": [
      {
        "signal": {"kind": "literal_phrase", "value": "确认意见", "field": null},
        "location": "cover",
        "reason": "中介机构/控股股东确认意见类文件的标题短语（常为扫描件）"
      },
      {
        "signal": {"kind": "literal_phrase", "value": "管理制度", "field": null},
        "location": "cover",
        "reason": "制度文件标题短语；但必须正文核实，标题可能误导"
      },
      {
        "signal": {"kind": "literal_phrase", "value": "通知", "field": null},
        "location": "cover",
        "reason": "会议通知/制度通知类标题短语"
      },
      {
        "signal": {"kind": "literal_phrase", "value": "签字", "field": null},
        "location": "body",
        "reason": "签章/签字页内容提示行政属性"
      }
    ],
    "counterexamples": [
      "不按文件名或标题跳过：标题像制度的文件正文可能是投资者关系活动记录（有价值）",
      "不按空 OCR 结果跳过：扫描确认函可能需要有限 OCR 才能判断",
      "标题含“招股说明书”的确认意见不是招股正文",
      "正文核实确为纯程序性（签字、盖章、通知）才可 skip 派生",
      "行政附件混在业务文件中时只跳过行政部分，不得连带丢弃业务内容"
    ]
  },
  "sections": [
    {
      "role": "administrative",
      "aliases": ["确认意见", "声明", "通知", "签章", "会议安排"],
      "heading_path": [["确认意见", "声明", "通知", "签章", "会议安排"]],
      "priority": 1,
      "questions": ["正文是否真为纯程序性", "是否包含经营议案/实质附件"]
    },
    {
      "role": "business",
      "aliases": ["问答记录", "经营情况", "附件", "议案内容"],
      "heading_path": [["问答记录", "经营情况", "附件", "议案"]],
      "priority": 2,
      "questions": ["若正文含经营内容（如活动记录、议案），按实际内容走对应 family"]
    }
  ],
  "reading_questions": [
    "正文是否纯程序性（确认、通知、签章）",
    "是否有经营议案、活动记录或实质附件",
    "扫描件/空文本是否需要 OCR 后再判",
    "确认无业务后只留来源与诊断"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": ["subject", "period"],
      "missing_behavior": "unknown",
      "reason": "任何从行政件提取的断言都要绑定主体与文件时点"
    },
    {
      "when": "explicit_condition_present",
      "slots": ["condition", "modality"],
      "missing_behavior": "deferred",
      "reason": "确认/声明的作用域与条件保留"
    }
  ],
  "deprioritize": [
    {
      "content": "签字、盖章、身份证件、报备清单",
      "unless": "用于来源真实性与版本确认"
    }
  ],
  "fallback": {
    "unread": "空原生文本/扫描件走有限 OCR 或 needs_source，不因空结果直接判无业务",
    "ambiguous": "标题与正文不一致时以正文为准并记录 alternatives/reason",
    "no_business": "核实纯程序性后 eligible_skip_after_read，原件与来源记录保留"
  },
  "evidence_status": {
    "design": "verified",
    "real_samples": ["case-admin-scan-empty-01"],
    "missing_shapes": [
      "真正制度/会议通知负例原件缺失（cn-ir-policy 不能作制度负例；已入 acquisition_requests）",
      "扫描件 OCR 路径未在本包验证"
    ]
  },
  "case_ids": ["case-admin-scan-empty-01", "case-synth-admin-notice-01"]
}
