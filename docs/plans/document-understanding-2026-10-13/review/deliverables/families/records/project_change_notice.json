  "reading_questions": [
    "原计划 vs 本次变化（无旧版则标 not_compared）",
    "变化范围：全部还是部分子项目",
    "剩余承诺与资金安排",
    "变更原因的归因（客观条件 vs 管理层解释）",
    "对达产时间/产能口径的影响"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "公告是事件时点事实，断言必须绑定主体与公告日期"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "变化断言必须同时保留原计划与现计划（缺原计划则 unknown/deferred）"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "已投入/剩余/调整后金额与产能变化必须带口径"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "新承诺/新计划的条件语气保留"
    }
  ],
  "deprioritize": [
    {
      "content": "审议程序、独立董事意见、股东大会安排",
      "unless": "程序本身构成变更生效条件"
    },
    {
      "content": "备查文件清单",
      "unless": "需要定位旧版文件证据"
    }
  ],
  "fallback": {
    "unread": "公告为扫描/缺文本时 needs_source，不因空结果判为无变化",
    "ambiguous": "变更/进展/延期/终止混淆时按正文动词与前后对照判型，保守标 unknown",
    "no_business": "纯程序性公告核实后 eligible_skip_after_read"
  },
  "evidence_status": {
    "design": "proposed",
    "real_samples": [],
    "missing_shapes": [
      "募投变更/延期/终止/进展公告真实样本缺失（已入 acquisition_requests）",
      "与原募集说明书的版本对缺失，delta 无法真实验证"
    ]
  },
