  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "募集说明书数据带编制时点，断言必须绑定主体与 as-of 期间"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "subject",
        "stage",
        "condition",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "项目断言必须整包保留项目名、实施主体、建设/投产阶段与条件，禁止跨项目拼接"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "投资额、产能、效益测算数值必须带单位、口径与测算/实际标记"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "可行性结论与效益测算自带条件与免责表述，必须随事实保留"
    }
  ],
  "deprioritize": [
    {
      "content": "发行程序、定价原则、认购邀请安排",
      "unless": "与募资规模/项目资金到位条件直接相关"
    },
    {
      "content": "本次发行前后的股本摊薄明细",
      "unless": "问题涉及股本或每股口径"
    }
  ],
  "fallback": {
    "unread": "跨页项目表读不全时记 partial/deferred，不得截半个项目冒充完整",
    "ambiguous": "注册稿/申报稿/发行公告混淆时按正文与版本标注判型，保留 alternatives",
    "no_business": "确无业务内容时 eligible_skip_after_read"
  },
