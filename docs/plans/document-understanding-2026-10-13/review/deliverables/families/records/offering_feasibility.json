    "项目背景与现有业务的关系",
    "产品/产能口径（新增 vs 总量）与分期",
    "投资估算构成与资金筹措",
    "效益测算假设（负荷、价格、建设期）",
    "审批/许可条件与不确定性分析"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "可研是编制时点的假设性研究，断言必须绑定主体与 as-of"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "项目断言整包保留主体、建设阶段、地点与条件"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "产能、投资额、测算收入必须带单位与测算标记"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "假设与免责声明随测算保留"
    }
  ],
  "deprioritize": [
    {
      "content": "厂址比选、设备清单、总图运输等工程细节",
      "unless": "涉及产能口径、投资构成或许可条件"
    },
    {
      "content": "组织机构与劳动定员章节",
      "unless": "涉及成本口径或实施能力"
    }
  ],
  "fallback": {
    "unread": "不可读部分 deferred，不以封面结论代替正文",
    "ambiguous": "可研与项目申请/备案/环评混淆时按正文结构判型",
    "no_business": "确无业务内容时 eligible_skip_after_read"
  },
