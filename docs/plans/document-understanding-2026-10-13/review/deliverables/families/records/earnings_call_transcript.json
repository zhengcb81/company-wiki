        [
          "Guidance",
          "Outlook"
        ]
      ],
      "priority": 1,
      "questions": [
        "指引的期间、口径与全局限定语"
      ],
      "geometry_intent": {
        "discover": "context_only",
        "fine": "explicit_only",
        "demand_class": "context"
      }
    },
    {
      "role": "operating_metrics",
      "aliases": [
        "KPI",
        "Seats",
        "RPO",
        "growth rates",
        "指标"
      ],
      "heading_path": [
        [
          "Prepared Remarks",
          "Q&A"
        ],
        [
          "KPI",
          "Seats",
          "remaining performance obligation",
          "growth rates"
        ]
      ],
      "priority": 2,
      "questions": [
        "经营指标定义与口径",
        "增长率的基期与币种口径"
      ],
      "geometry_intent": {
        "discover": "context_only",
        "fine": "explicit_only",
        "demand_class": "context"
      }
    },
    {
      "role": "administrative",
      "aliases": [
        "CALL PARTICIPANTS",
        "Operator",
        "免责声明",
        "Glossary"
      ],
      "heading_path": [
        [
          "CALL PARTICIPANTS",
          "Operator",
          "Glossary",
          "Forward-Looking Statements"
        ]
      ],
      "priority": 3,
      "questions": [
        "参与人角色表、编辑附加内容与真实发言的分界"
      ],
      "geometry_intent": {
        "discover": "context_only",
        "fine": "unknown",
        "demand_class": "administrative"
      }
    }
  ],
  "reading_questions": [
    "Prepared Remarks 与 Q&A 的发言者归属",
    "编辑摘要/术语表与真实发言的分离",
    "分析师问题内容不等于公司披露",
    "管理层修正、补充与明确否定",
    "全局限定语（constant currency、non-GAAP）随局部事实保留"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period",
        "role"
      ],
      "missing_behavior": "unknown",
      "reason": "电话会内容必须绑定发言人角色（管理层/分析师/编辑/主持）与期间"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "数值必须带期间、币种/constant currency 与分母口径"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "指引与展望的条件语气必须保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "geography",
        "stage"
      ],
      "missing_behavior": "partial",
      "reason": "数据中心/产能/产品进度保留地域与阶段"
    }
  ],
  "deprioritize": [
    {
      "content": "Operator 串词、免责声明、参与人名单、术语表",
      "unless": "用于角色归属与来源界定"
    },
    {
      "content": "编辑 takeaways/摘要块",
      "unless": "作为“第三方转述”标注保留，不当公司披露"
    }
  ],
  "fallback": {
    "unread": "TXT/HTML 不可读部分 deferred；问答对不拆散",
    "ambiguous": "聚合平台抓取件与公司原始披露混淆时按来源角色分开标注，不当作公司发布原文",
    "no_business": "确无业务内容时 eligible_skip_after_read"
  },
  "evidence_status": {
    "design": "verified",
    "real_samples": [
      "case-earnings-call-roles-01"
    ],
    "missing_shapes": [
      "公司原始发布版实录（当前样本为聚合平台 TXT）",
      "中英双语电话会实录"
    ]
  },
