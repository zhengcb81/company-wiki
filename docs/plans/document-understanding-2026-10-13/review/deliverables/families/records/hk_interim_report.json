  "reading_questions": [
    "六个月累计口径的本期变化",
    "与年报共用模板但周期不丢",
    "期后事项（含融资、收购）单列",
    "同店/门店等经营指标的可比口径",
    "未审计状态对数值的限定"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "中期数据为期末止六个月口径且未审计"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "六个月/单季/同比基期、存量/净增、地域与模式范围分开"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality",
        "period"
      ],
      "missing_behavior": "deferred",
      "reason": "期后发展与展望的时点限定必须保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "融资、收购、新市场进入必须保留阶段与条件（如期后完成 vs 报告期内）"
    }
  ],
  "deprioritize": [
    {
      "content": "未经审计综合财务报表与纯会计附注",
      "unless": "其中含经营解释或业务机制"
    },
    {
      "content": "企业管治等常规章节",
      "unless": "含重大经营事实"
    }
  ],
  "fallback": {
    "unread": "双栏/复杂排版串读时 deferred，交布局层恢复顺序",
    "ambiguous": "期后事项与报告期内事项混淆时按日期与措辞分开，存疑标 unknown",
    "no_business": "核实无业务内容后 eligible_skip_after_read"
  },
