  "recognition": {
    "positive": [
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "招股说明书",
          "field": null
        },
        "location": "cover",
        "reason": "A股招股说明书封面标题；需正文结构佐证"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "发行人基本情况",
          "field": null
        },
        "location": "toc",
        "reason": "A股招股章节体系（发行人情况/业务与技术/募集资金运用）是正文证据"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "业务与技术",
          "field": null
        },
        "location": "toc",
        "reason": "业务与技术章节是招股说明书的核心业务信息来源"
      },
      {
        "signal": {
          "kind": "metadata_equals",
          "value": "cn_exchange",
          "field": "regime"
        },
        "location": "metadata",
        "reason": "A股披露制度"
      }
    ],
    "counterexamples": [
      "标题含“招股说明书”但正文是控股股东、实际控制人或中介机构确认意见的文件不是招股正文",
      "招股意向书、发行公告、上市公告书不是招股说明书正文",
      "招股说明书是发行时点的历史事实基础：2019年的计划不得写成当前现状",
      "招股书中引用的第三方行业研究/顾问估计不是公司实际业绩，须保留作者归属",
      "客户匿名披露（客户A/客户B）不得猜测真实公司名"
    ]
  },
