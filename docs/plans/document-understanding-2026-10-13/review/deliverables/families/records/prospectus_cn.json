  "reading_questions": [
    "业务基础知识：产品、客户、供应商、销售与生产机制",
    "发行时点（历史）事实：与当前状态区分",
    "行业口径与第三方统计归属",
    "募投用途与项目结构（主体、投资额、建设期、达产）",
    "客户匿名与集中度口径",
    "增长策略与风险的具体表述"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "招股信息是发行时点的历史基础，断言必须带 as-of 期间"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "产销量、产能、集中度等数值必须带期间、单位与分母"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "募投项目断言必须带主体、建设/达产阶段与实现条件"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "预测、估计、可行性结论自带条件，必须随事实保留"
    }
  ],
  "deprioritize": [
    {
      "content": "发行承销安排、股利分配政策、中介机构名单",
      "unless": "与募资用途或项目条件直接相关"
    },
    {
      "content": "历史沿革中的纯工商变更明细",
      "unless": "涉及控制权、业务重组或资产注入"
    }
  ],
  "fallback": {
    "unread": "400+ 页长文档按缺口补读并记 deferred，禁止只读前若干页宣称完整",
    "ambiguous": "确认意见/意向书/公告与正文混淆时按正文结构判型并保留 alternatives",
    "no_business": "确无业务内容时 eligible_skip_after_read"
  },
  "evidence_status": {
    "design": "verified",
    "real_samples": [
      "case-cn-ipo-offering-facts-01",
      "case-cn-ipo-proceeds-02"
    ],
    "missing_shapes": [
      "招股说明书注册稿/正式稿版本对",
      "更多行业（当前样本为半导体设备）"
    ]
  },
  "case_ids": [
    "case-cn-ipo-offering-facts-01",
    "case-cn-ipo-proceeds-02"
  ]
}
