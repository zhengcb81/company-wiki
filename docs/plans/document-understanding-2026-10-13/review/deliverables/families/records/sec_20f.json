  "reading_questions": [
    "业务与组织结构（含注册地/上市地/业务市场的区分）",
    "经营回顾中的业务驱动",
    "监管约束对业务的事实影响及归因",
    "具体风险与一般风险的区分",
    "币种、会计准则与报告期口径",
    "区分真实Item 3 Key Information下D Risk Factors正文与目录/see Item交叉引用；Item 7股东交易不套10-K的MD&A。"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period",
        "geography"
      ],
      "missing_behavior": "unknown",
      "reason": "20-F 主体常跨注册地/上市地/经营地，断言必须绑定主体、期间与地域"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "币种、会计准则与分母口径必须随数值保留"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "监管条件、VIE 结构与展望的限定语随事实保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "geography",
        "stage"
      ],
      "missing_behavior": "partial",
      "reason": "区域扩张/学校/中心等项目断言保留地域与阶段"
    }
  ],
  "deprioritize": [
    {
      "content": "公司结构图、VIE 合同清单等法律结构描述",
      "unless": "其中含对经营的实际约束或监管事实"
    },
    {
      "content": "董事履历、薪酬、股本变动等常规章节",
      "unless": "含重大经营事实"
    }
  ],
  "fallback": {
    "unread": "不可读部分 deferred 并记录，不以空结果判无业务",
    "ambiguous": "20-F 与 10-K/40-F 混淆时用 Item 编号与 form_type 正文证据判型",
    "no_business": "核实无业务内容后 eligible_skip_after_read"
  },
