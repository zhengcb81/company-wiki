  "reading_questions": [
    "上半年（累计）经营变化及原因",
    "项目/产品进度与阶段证据",
    "下半年安排及其条件",
    "与年报口径的差异（半年累计非单季）",
    "未审计状态对数值引用的限定"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "半年报数据是上半年累计口径且未经审计，断言必须绑定主体与期间"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "半年累计、单季、同比基期必须分开；缺口径不得单独引用数值"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "项目进度/送样验证/重复订单等断言必须保留项目主体与阶段"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "下半年计划、未审计声明等限定语随事实保留"
    }
  ],
  "deprioritize": [
    {
      "content": "常规三表与纯财务附注",
      "unless": "其中含经营驱动解释或业务附注"
    },
    {
      "content": "董监高声明、分红预案等程序性内容",
      "unless": "其中含影响经营的重大事实"
    }
  ],
  "fallback": {
    "unread": "扫描页/缺原生文本时记录缺口走 generic_read 或 needs_source，不因空文本跳过",
    "ambiguous": "半年报与摘要件、单季报混淆时按正文结构与未审计声明判型，保留 alternatives",
    "no_business": "正文核实无经营内容后 eligible_skip_after_read，保留来源与诊断"
  },
