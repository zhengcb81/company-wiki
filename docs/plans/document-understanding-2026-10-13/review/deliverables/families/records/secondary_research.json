{
  "schema_version": "du2-family-spec/1",
  "id": "secondary_research",
  "version": "1.0.1",
  "applies_to": {
    "regimes": [
      "other",
      "unknown"
    ],
    "forms": [],
    "family": "unknown",
    "purposes": [
      "secondary_context"
    ],
    "modifiers": {
      "extent": [
        "full",
        "summary",
        "unknown"
      ],
      "revision": [
        "original",
        "amended",
        "supplement",
        "unknown"
      ]
    },
    "carrier": [
      "pdf",
      "html",
      "md",
      "txt"
    ],
    "language": [
      "zh",
      "en"
    ]
  },
  "recognition": {
    "positive": [
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "证券研究报告",
          "field": null
        },
        "location": "cover",
        "reason": "券商研报标题短语，提示第三方研究来源"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "研究员",
          "field": null
        },
        "location": "body",
        "reason": "研报署名区短语，来源角色为研究员"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "政策",
          "field": null
        },
        "location": "cover",
        "reason": "政策文件标题短语，发文主体为监管/政府"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "ESG报告",
          "field": null
        },
        "location": "cover",
        "reason": "ESG/可持续发展报告标题短语，公司披露但口径特殊"
      }
    ],
    "counterexamples": [
      "研究机构的预测、评级、目标价不是公司承诺，也不是公司披露事实",
      "记者转述与公司披露分开：新闻稿被报道后仍是公司口径，报道本身是媒体口径",
      "政策发文主体与适用范围要保留，政策影响不得直接当公司业绩",
      "研报转引的公司数据必须回链公司披露原件才能当公司事实",
      "本模块不生成研究结论、评级或投资建议"
    ]
  },
  "sections": [
    {
      "role": "business",
      "aliases": [
        "核心观点",
        "公司分析",
        "行业分析",
        "事件点评"
      ],
      "heading_path": [
        [
          "核心观点",
          "公司分析",
          "行业分析",
          "事件点评",
          "主要内容"
        ]
      ],
      "priority": 1,
      "questions": [
        "与业务相关的新事实、约束或机会",
        "内容的作者/发文主体是谁"
      ]
    },
    {
      "role": "industry",
      "aliases": [
        "行业研究",
        "政策解读",
        "监管",
        "市场规模"
      ],
      "heading_path": [
        [
          "行业研究",
          "政策解读",
          "监管",
          "市场规模"
        ]
      ],
      "priority": 2,
      "questions": [
        "政策/行业事实的发文主体、适用范围与生效期"
      ]
    },
    {
      "role": "outlook",
      "aliases": [
        "预测",
        "展望",
        "投资建议",
        "盈利预测"
      ],
      "heading_path": [
        [
          "预测",
          "展望",
          "投资建议",
          "盈利预测"
        ]
      ],
      "priority": 3,
      "questions": [
        "预测与建议标注为第三方观点，不当公司承诺"
      ]
    },
    {
      "role": "risk",
      "aliases": [
        "风险提示",
        "不确定性"
      ],
      "heading_path": [
        [
          "风险提示",
          "不确定性"
        ]
      ],
      "priority": 2,
      "questions": [
        "第三方提示的风险与公司披露风险的来源区分"
      ]
    }
  ],
  "reading_questions": [
    "与业务相关的新事实、约束/机会、具体产能或监管进度",
    "公司披露/记者/研究员/政策发文主体的区分",
    "研究预测不得当公司承诺",
    "仅保留源信息，不在本系统生成研究结论"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period",
        "role"
      ],
      "missing_behavior": "unknown",
      "reason": "第三方内容必须绑定作者/发文主体、时点与角色"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "第三方统计/预测数值必须带作者、口径与实际/预测标记"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "预测与政策适用条件随内容保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "项目相关表述保留阶段与条件，并回链公司披露"
    }
  ],
  "deprioritize": [
    {
      "content": "评级、目标价、估值表、投资建议",
      "unless": "仅作为第三方观点属性记录（不进入业务事实）"
    },
    {
      "content": "免责声明、分析师名录、销售团队联系",
      "unless": "用于来源角色界定"
    }
  ],
  "fallback": {
    "unread": "不可读部分 deferred；不以摘要/搜索片段代替正文建金标",
    "ambiguous": "公司披露 vs 媒体/研究转述不清时按作者与发布主体标注，存疑降权",
    "no_business": "与经营无关的纯观点/评级内容可 eligible_skip_after_read"
  },
  "evidence_status": {
    "design": "proposed",
    "real_samples": [],
    "missing_shapes": [
      "研报/新闻/政策/ESG 样本未纳入母计划 20 份样本（已入 acquisition_requests）",
      "第三方转引与公司披露的回链验证未做"
    ]
  },
  "case_ids": [
    "case-synth-secondary-01"
  ]
}
