{
  "schema_version": "du2-family-spec/1",
  "id": "investor_presentation",
  "version": "1.0.0",
  "applies_to": {
    "regimes": ["sec", "hkex", "cn_exchange", "other"],
    "forms": [],
    "family": "presentation",
    "purposes": ["management_qa", "event_update"],
    "modifiers": {"extent": "summary", "revision": "original"},
    "carrier": ["pdf", "pptx", "image"],
    "language": ["en", "zh"]
  },
  "recognition": {
    "positive": [
      {
        "signal": {"kind": "literal_phrase", "value": "Investor Presentation", "field": null},
        "location": "cover",
        "reason": "投资者演示封面"
      },
      {
        "signal": {"kind": "literal_phrase", "value": "业绩展示", "field": null},
        "location": "cover",
        "reason": "中文语境的业绩展示/演示材料标题"
      },
      {
        "signal": {"kind": "metadata_equals", "value": "application/pdf", "field": "mime_type"},
        "location": "metadata",
        "reason": "载体提示；PPT/PDF/图片都可能，不能只按载体判型"
      }
    ],
    "counterexamples": [
      "图题/图例/坐标轴/单位/时间随数据一起读，缺图不可声称完整",
      "不猜图上数字：图读不出时标 unread/needs_source",
      "演示材料的市场口径（GMV、同店、RPO）不等于收入",
      "同一业绩事件的 deck 与 release 内容重复时事实层去重、引用保留",
      "路演问答、媒体实录不是演示材料本身"
    ]
  },
  "sections": [
    {
      "role": "business",
      "aliases": ["Business Overview", "Company Overview", "Strategy", "业务概览"],
      "heading_path": [["Business Overview", "Company Overview", "Strategy", "业务概览"]],
      "priority": 1,
      "questions": ["一页一个主题：业务构成、战略与进展"]
    },
    {
      "role": "operating_metrics",
      "aliases": ["Operating Metrics", "KPI", "Store Network", "Financial Highlights"],
      "heading_path": [["Operating Metrics", "KPI", "Store Network", "Financial Highlights", "经营指标"]],
      "priority": 1,
      "questions": ["图/表的单位、期间、口径与脚注", "指标定义（GMV/同店/RPO）"]
    },
    {
      "role": "outlook",
      "aliases": ["Outlook", "Guidance", "Targets", "展望"],
      "heading_path": [["Outlook", "Guidance", "Targets", "展望"]],
      "priority": 2,
      "questions": ["目标/展望的期间与假设"]
    },
    {
      "role": "financial_notes",
      "aliases": ["Notes", "Disclaimer", "Appendix", "脚注"],
      "heading_path": [["Notes", "Disclaimer", "Appendix", "脚注"]],
      "priority": 2,
      "questions": ["脚注限定语与数据定义随图保留"]
    }
  ],
  "reading_questions": [
    "每个 slide/图/指标构成一个证据包",
    "图题、图例、坐标轴、单位、时间口径随数据",
    "产能/门店/客户组合等图的口径",
    "展望/目标的条件",
    "与 release/call 的重复事实控制"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": ["subject", "period"],
      "missing_behavior": "unknown",
      "reason": "演示图表都带截止期，断言必须绑定主体与期间"
    },
    {
      "when": "quantity_emitted",
      "slots": ["quantity", "unit", "period", "denominator", "geography"],
      "missing_behavior": "partial",
      "reason": "图上数值必须带单位、口径与地域；缺任一标 partial"
    },
    {
      "when": "explicit_condition_present",
      "slots": ["condition", "modality"],
      "missing_behavior": "deferred",
      "reason": "目标/展望与脚注限定语随数据保留"
    },
    {
      "when": "project_emitted",
      "slots": ["project", "stage"],
      "missing_behavior": "partial",
      "reason": "路线图/产能图保留项目阶段与条件"
    }
  ],
  "deprioritize": [
    {
      "content": "封面、目录、免责声明、联系方式",
      "unless": "用于来源与版本界定"
    },
    {
      "content": "纯装饰图片、团队照片",
      "unless": "含产品/产能/客户等可读信息"
    }
  ],
  "fallback": {
    "unread": "图表 OCR/图像识别失败时保留坐标/标题/脚注并标 unread，不猜数字",
    "ambiguous": "deck 与 release 内容重复时保留双引用并在事实层去重",
    "no_business": "纯财务图表页可只保留指标定义与口径，业务摘要为空"
  },
  "evidence_status": {
    "design": "verified",
    "real_samples": ["case-hk-deck-chart-01"],
    "missing_shapes": ["PPTX/图片形态本地原件", "图表 OCR 完整性验证（不在本包范围，归 ROOT/共享链）"]
  },
  "case_ids": ["case-hk-deck-chart-01"]
}
