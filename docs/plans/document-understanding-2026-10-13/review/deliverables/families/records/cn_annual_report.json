  "recognition": {
    "positive": [
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "年年度报告",
          "field": null
        },
        "location": "cover",
        "reason": "A股年报封面标题稳定形如《……年年度报告》，是用途识别的第一证据"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "管理层讨论与分析",
          "field": null
        },
        "location": "toc",
        "reason": "目录含管理层讨论与分析章节，是定期经营回顾正文的结构证据"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "主要会计数据和财务指标",
          "field": null
        },
        "location": "body",
        "reason": "A股定期报告模板固定小节，支持定期报告识别"
      },
      {
        "signal": {
          "kind": "metadata_equals",
          "value": "cn_exchange",
          "field": "regime"
        },
        "location": "metadata",
        "reason": "A股披露制度；上市地不能代替用途，仅与标题/正文证据组合"
      }
    ],
    "counterexamples": [
      "标题含“年度报告”但正文是独立董事述职报告、监事会工作报告或董事会工作报告的文件不是年报正文",
      "《年度报告摘要》只是摘要件，缺失章节不得当作全文年报（见 lifecycle 修饰记录）",
      "媒体、研究机构或数据商撰写的“年报点评/年报解读”不是公司披露原件",
      "港股/美股年报封面 Annual Report 章节模板不同，不适用本规格，须走 hk_annual_report 或 sec_10k/sec_20f",
      "以“年年度报告”为标题的募集资金专项说明、内部控制评价报告等附件不能替代年报正文"
    ]
  },
