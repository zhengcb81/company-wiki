  "reading_questions": [
    "报告期主营业务构成、主要产品与收入机制",
    "相比上一报告期发生了哪些经营变化及其原因",
    "新产品/第二曲线所处阶段与证据（开发→送样→验证→小批量→量产→规模化）",
    "产能、订单、利用率、出货等经营指标及其口径",
    "海外/新市场的实际进入程度与主体归属",
    "公司下一阶段计划、附带条件与不确定性",
    "风险因素中已发生事实与一般性提示的区分"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "年报所有经营与财务叙述都是报告期口径，断言必须绑定披露主体与报告期"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "收入拆分、产销量等数值必须保留单位、期间与地域/合并范围，缺任一不得单独引用"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "产能/募投/研发项目断言必须保留项目主体、建设或验证阶段与实现条件，计划不等于承诺"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "前瞻性陈述、计划与测算自带限定语，限定语必须随局部事实保留"
    }
  ],
  "deprioritize": [
    {
      "content": "合并财务报表、常规三表、账龄与税费明细等纯财务表",
      "unless": "其中包含经营驱动解释、业务相关附注或经营指标"
    },
    {
      "content": "董监高任职与薪酬、股东大会程序、公司治理常规披露",
      "unless": "其中包含重大经营事项、股权变动或对经营的实际约束"
    },
    {
      "content": "目录、页眉页脚、备查文件与签字盖章页",
      "unless": "用于确认文档版本、完整性与真实来源"
    }
  ],
  "fallback": {
    "unread": "原生文本缺失或扫描页时记录缺口，进入 generic_read 或 needs_source，不因空文本判定无业务内容",
    "ambiguous": "标题、元数据与正文证据冲突时保留 alternatives 与 reason，按保守 generic 阅读，不新增人工签收门",
    "no_business": "正文完整读过并确认无经营内容后可 eligible_skip_after_read，仅保留来源、覆盖记录与诊断"
  },
  "evidence_status": {
