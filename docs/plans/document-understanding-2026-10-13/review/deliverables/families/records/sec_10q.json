  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period"
      ],
      "missing_behavior": "unknown",
      "reason": "10-Q 数值区分 quarter 与 year-to-date，断言必须绑定主体与期间口径"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "GAAP/non-GAAP、单季/YTD、同比基期分开，缺一不得引用"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "指引与全局限定语（如 constant currency）随局部事实保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "geography"
      ],
      "missing_behavior": "partial",
      "reason": "项目/产能/产品进度断言保留阶段与地域"
    }
  ],
  "deprioritize": [
    {
      "content": "精简财务报表与常规附注",
      "unless": "含收入机制、分部或经营解释"
    },
    {
      "content": "Controls and Procedures 等程序章节",
      "unless": "含对经营的实际约束"
    }
  ],
  "fallback": {
    "unread": "HTML ix 元数据与内嵌样式不计正文；不可读部分 deferred",
    "ambiguous": "form_type 缺失时用 Part/Item 正文结构判型，保留 alternatives",
    "no_business": "纯财务季报可正确跳过派生，0 LLM 调用，仅留来源与覆盖记录"
  },
