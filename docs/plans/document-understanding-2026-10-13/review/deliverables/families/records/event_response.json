  "reading_questions": [
    "事件的主体、标的、金额、条件与时间",
    "被询问的业务细节与公司回复的来源角色",
    "合同额 vs 确认收入、对价 vs 经营收入",
    "履约/建设进度与项目成本口径",
    "终止/变更/延期的语义区分"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period",
        "role"
      ],
      "missing_behavior": "unknown",
      "reason": "问询/公告内容有来源角色（监管提问 vs 公司回复），断言必须绑定主体、时点与角色"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "合同额、对价、投资额、收入是不同口径，必须带定义与期间"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "stage",
        "condition"
      ],
      "missing_behavior": "partial",
      "reason": "项目/标的断言整包保留阶段与条件"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "生效条件、先决条件与假设必须随事实保留"
    }
  ],
  "deprioritize": [
    {
      "content": "备查文件、法律顾问声明、程序性决议",
      "unless": "构成事件生效条件"
    },
    {
      "content": "问询函中的重复背景叙述",
      "unless": "包含新的业务细节问题"
    }
  ],
  "fallback": {
    "unread": "长回复不可读部分 deferred，问答对/引用不拆散",
    "ambiguous": "事件类型（重组/合同/问询/终止）混判时保留 alternatives，按正文动词与条件判型",
    "no_business": "纯程序性事件核实后 eligible_skip_after_read"
  },
  "evidence_status": {
    "design": "proposed",
    "real_samples": [],
