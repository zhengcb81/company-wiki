      "role": "administrative",
      "aliases": [
        "Item 1B",
        "Item 1C",
        "Item 2. Properties",
        "Item 3. Legal Proceedings",
        "Item 9A. Controls"
      ],
      "heading_path": [
        [
          "Item 2. Properties",
          "Item 3. Legal Proceedings",
          "Item 9A. Controls and Procedures"
        ]
      ],
      "priority": 3,
      "questions": [
        "是否有影响经营的诉讼、物业或控制事项事实"
      ],
      "geometry_intent": {
