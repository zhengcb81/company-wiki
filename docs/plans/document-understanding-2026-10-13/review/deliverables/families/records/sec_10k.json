  "reading_questions": [
    "业务模式、分部构成与收入确认机制",
    "报告期经营驱动与同比口径解释",
    "KPI/经营指标的定义、分母与期间",
    "业务风险的更新与已发生事实",
    "展望/指引及全局限定语（如 constant currency）",
    "合同、履约义务、剩余履约义务等商业机制描述"
  ],
  "context_requirements": [
    {
      "when": "always_for_assertion",
      "slots": [
        "subject",
        "period",
        "role"
      ],
      "missing_behavior": "unknown",
      "reason": "10-K 数值与叙述都带报告期；MD&A 管理层陈述与附注/审计信息来源角色不同"
    },
    {
      "when": "quantity_emitted",
      "slots": [
        "quantity",
        "unit",
        "period",
        "denominator"
      ],
      "missing_behavior": "partial",
      "reason": "分部收入、KPI、RPO 等数值必须保留单位、期间与分母定义，RPO/订单不等于收入"
    },
    {
      "when": "explicit_condition_present",
      "slots": [
        "condition",
        "modality"
      ],
      "missing_behavior": "deferred",
      "reason": "forward-looking、guidance、constant currency 等限定语随局部事实保留"
    },
    {
      "when": "project_emitted",
      "slots": [
        "project",
        "geography",
        "stage"
      ],
      "missing_behavior": "partial",
      "reason": "数据中心、产能、产品发布等项目/进度断言需保留地域与阶段"
    }
  ],
  "deprioritize": [
    {
      "content": "Item 8 常规三表与附注中的纯会计科目明细",
      "unless": "其中含收入确认、履约义务、分部或合同等商业机制描述"
    },
    {
      "content": "Human Capital、Properties、Controls 等常规章节",
      "unless": "其中含对经营的实际约束或重大变化事实"
    },
    {
      "content": "目录、交叉引用指引、签名页与 Exhibit 索引",
      "unless": "用于确认章节定位、版本与附件完整性"
    }
  ],
  "fallback": {
    "unread": "ix:header/ix:hidden 等内嵌元数据不作为正文；部分页面不可读时记 deferred 并进入 generic_read",
    "ambiguous": "form_type 缺失或与正文冲突时保留 alternatives 与 reason，用 Item 编号正文证据判型，不按文件名定型",
    "no_business": "确无业务内容（纯财务/纯程序）时 eligible_skip_after_read，仅留来源与诊断"
  },
  "evidence_status": {
    "design": "verified",
    "real_samples": [
      "case-sec-10k-segments-01",
      "case-sec-10k-rpo-02",
      "case-sec-10k-toc-vs-body-03"
    ],
    "missing_shapes": [
      "完整 10-K 附注金标未建",
      "10-K/A 修订版本对缺失"
    ]
  },
  "case_ids": [
    "case-sec-10k-segments-01",
    "case-sec-10k-rpo-02",
    "case-sec-10k-toc-vs-body-03"
  ]
}
