{
  "schema_version": "du2-family-spec/1",
  "id": "sec_10k",
  "version": "1.0.2",
  "applies_to": {
    "regimes": [
      "sec"
    ],
    "forms": [
      "10-K"
    ],
    "family": "annual",
    "purposes": [
      "periodic_review",
      "business_baseline"
    ],
    "modifiers": {
      "extent": [
        "full",
        "summary",
        "unknown"
      ],
      "revision": [
        "original",
        "amended",
        "supplement",
        "unknown"
      ]
    },
    "carrier": [
      "html"
    ],
    "language": [
      "en"
    ]
  },
  "recognition": {
    "positive": [
      {
        "signal": {
          "kind": "metadata_equals",
          "value": "10-K",
          "field": "form_type"
        },
        "location": "metadata",
        "reason": "SEC form_type 为 10-K 是最强识别证据，但仍需正文结构佐证"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "Item 1. Business",
          "field": null
        },
        "location": "body",
        "reason": "10-K 正文按 Item 编号组织，Item 1 业务章节是用途证据"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "Item 7. Management",
          "field": null
        },
        "location": "body",
        "reason": "10-K 的 MD&A 固定在 Item 7，与 20-F 的 Item 5、10-Q 的 Part I Item 2 不同"
      },
      {
        "signal": {
          "kind": "literal_phrase",
          "value": "Annual Report",
          "field": null
        },
        "location": "cover",
        "reason": "封面常同时出现 Annual Report 与 Form 10-K 字样，作弱提示"
      }
    ],
    "counterexamples": [
      "10-K/A 是修订件，原版与修订版不得混读（见 lifecycle 修饰记录）",
      "目录页的 Item 列表不是正文；目录命中不能当作已读业务章节",
      "20-F 的 Item 4/Item 5 与 10-K 的 Item 1/Item 7 编号含义不同，不得互相套用",
      "10-Q 的 Item 2 在 Part I，另有 Part II Item 1A 风险更新，Part 层级不可混入 10-K 结构",
      "封面含 Annual Report 的股东信或业绩发布不是 10-K 正文"
    ]
  },
  "sections": [
    {
      "role": "business",
      "aliases": [
        "Item 1. Business",
        "Business",
        "Our Business"
      ],
      "heading_path": [
