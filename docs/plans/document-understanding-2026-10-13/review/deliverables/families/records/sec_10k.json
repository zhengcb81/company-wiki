      "geometry_intent": {
        "discover": "on_tabular_evidence",
        "fine": "on_candidate",
        "demand_class": "mixed"
      }
    },
    {
      "role": "outlook",
      "aliases": [
        "Outlook",
        "Guidance",
        "Forward-Looking Statements"
      ],
      "heading_path": [
        [
          "Item 7. Management's Discussion and Analysis",
          "Item 7 Management's Discussion and Analysis"
