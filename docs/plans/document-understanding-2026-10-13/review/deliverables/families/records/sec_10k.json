      ],
      "heading_path": [
        [
          "Item 7. Management's Discussion and Analysis",
          "Item 7 Management's Discussion and Analysis"
        ]
      ],
      "priority": 1,
      "questions": [
        "经营结果背后的业务驱动与解释",
        "同比/环比基期与口径"
      ],
      "geometry_intent": {
        "discover": "on_tabular_evidence",
        "fine": "on_candidate",
        "demand_class": "mixed"
      }
    },
    {
      "role": "financial_notes",
      "aliases": [
        "Item 8. Financial Statements",
