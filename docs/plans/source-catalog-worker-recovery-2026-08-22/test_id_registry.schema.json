{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:test-id-registry-instance:v4",
  "title":"Per-test stable ID registry instance schema",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "nodeList":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":80}},
    "optionalNodeList":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":80}},
    "lifecycle":{
      "type":"object","additionalProperties":false,
      "required":["introduced_at","variant_at","expected_red_at","required_green_at","revalidate_at"],
      "properties":{
        "introduced_at":{"$ref":"#/$defs/nodeList"},
        "variant_at":{"$ref":"#/$defs/optionalNodeList"},
        "expected_red_at":{"$ref":"#/$defs/nodeList"},
        "required_green_at":{"$ref":"#/$defs/nodeList"},
        "revalidate_at":{"$ref":"#/$defs/optionalNodeList"}
      }
    },
    "predicate":{
      "type":"object","additionalProperties":false,
      "required":["kind","selector_path","operator","allowed_values","selected_value","false_lifecycle"],
      "properties":{
        "kind":{"const":"PREDICATE"},
        "selector_path":{"type":"string","pattern":"^/[A-Za-z0-9._/-]+$"},
        "operator":{"const":"EQUALS"},
        "allowed_values":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "selected_value":{"type":"string","minLength":1},
        "false_lifecycle":{"const":"OMIT_ALL_LIFECYCLE_RECORDS"}
      }
    },
    "branchLifecycle":{
      "type":"object","additionalProperties":false,
      "required":["kind","selector_path","operator","allowed_values","unselected_branch_lifecycle","cases"],
      "properties":{
        "kind":{"const":"BRANCH_LIFECYCLE"},
        "selector_path":{"type":"string","pattern":"^/[A-Za-z0-9._/-]+$"},
        "operator":{"const":"SELECT_EXACTLY_ONE"},
        "allowed_values":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "unselected_branch_lifecycle":{"const":"OMIT_ALL_LIFECYCLE_RECORDS"},
        "cases":{"type":"object","minProperties":2,"maxProperties":2,"additionalProperties":{"$ref":"#/$defs/lifecycle"}}
      }
    },
    "test":{
      "type":"object","additionalProperties":false,
      "required":["id","group","introduced_at","variant_at","expected_red_at","required_green_at","revalidate_at","condition_id"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "group":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
        "introduced_at":{"$ref":"#/$defs/nodeList"},
        "variant_at":{"$ref":"#/$defs/optionalNodeList"},
        "expected_red_at":{"$ref":"#/$defs/nodeList"},
        "required_green_at":{"$ref":"#/$defs/nodeList"},
        "revalidate_at":{"$ref":"#/$defs/optionalNodeList"},
        "condition_id":{"anyOf":[{"type":"null"},{"enum":["MEASUREMENT_VM_STEP_EXACT","ADR02_SELECTED_BRANCH_LIFECYCLE","ADR02_NO_INDEX","ADR02_INDEX","ADR11_LLM_ENABLED","ADR11_SELECTED_PROFILE_LIFECYCLE","ADR11_LLM_ENABLED_ADR13_REVALIDATION","PARSER_ROUTE_MEDIUM_ENABLED"]}]}
      }
    },
    "template":{
      "type":"object","additionalProperties":false,
      "required":["template_id","pattern","introduced_at","required_green_at","revalidate_at","expansion_manifest_schema","expansion_manifest_due_node","expanded_ids_field","profile_path_field","profile_sha256_field","minimum_samples_field"],
      "properties":{
        "template_id":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
        "pattern":{"type":"string","minLength":10,"maxLength":300},
        "introduced_at":{"const":"T06P"},
        "required_green_at":{"const":"G06P"},
        "revalidate_at":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":2}},
        "expansion_manifest_schema":{"const":"parser_route_manifest.schema.json"},
        "expansion_manifest_due_node":{"const":"G06P"},
        "expanded_ids_field":{"const":"expanded_test_ids"},
        "profile_path_field":{"const":"release_profile_path"},
        "profile_sha256_field":{"const":"release_profile_sha256"},
        "minimum_samples_field":{"enum":["minimum_samples_medium_or_disabled","minimum_samples_oversize","minimum_samples_error","minimum_pause_sequences"]}
      }
    }
  },
  "required":["schema_id","contract","plan_revision","uniqueness_rule","condition_contract","condition_definitions","tests","templates","reference_extraction","gate_forbidden_tokens","validation"],
  "properties":{
    "schema_id":{"const":"urn:company-wiki:source-catalog-worker-recovery:test-id-registry-instance:v4"},
    "contract":{"const":"source-catalog-worker-recovery-stable-test-id-registry"},
    "plan_revision":{"const":"v4"},
    "uniqueness_rule":{"type":"string","minLength":30},
    "condition_contract":{
      "type":"object","additionalProperties":false,
      "required":["free_text_conditions_allowed","undefined_condition_ids_allowed","null_means_unconditional","branch_definition_arrays_are_exact_case_union","selected_case_is_only_runtime_lifecycle","unselected_case_ledger_records_allowed","evaluation_inputs_and_hashes_must_be_evidence"],
      "properties":{
        "free_text_conditions_allowed":{"const":false},
        "undefined_condition_ids_allowed":{"const":false},
        "null_means_unconditional":{"const":true},
        "branch_definition_arrays_are_exact_case_union":{"const":true},
        "selected_case_is_only_runtime_lifecycle":{"const":true},
        "unselected_case_ledger_records_allowed":{"const":false},
        "evaluation_inputs_and_hashes_must_be_evidence":{"const":true}
      }
    },
    "condition_definitions":{
      "type":"object","additionalProperties":false,
      "required":["MEASUREMENT_VM_STEP_EXACT","ADR02_SELECTED_BRANCH_LIFECYCLE","ADR02_NO_INDEX","ADR02_INDEX","ADR11_LLM_ENABLED","ADR11_SELECTED_PROFILE_LIFECYCLE","ADR11_LLM_ENABLED_ADR13_REVALIDATION","PARSER_ROUTE_MEDIUM_ENABLED"],
      "properties":{
        "MEASUREMENT_VM_STEP_EXACT":{"allOf":[{"$ref":"#/$defs/predicate"},{"properties":{"selector_path":{"const":"/measurement_manifest/measurement_mode"},"allowed_values":{"const":["STMTSTATUS_VM_STEP_EXACT"]},"selected_value":{"const":"STMTSTATUS_VM_STEP_EXACT"}}}]},
        "ADR02_SELECTED_BRANCH_LIFECYCLE":{"allOf":[{"$ref":"#/$defs/branchLifecycle"},{"properties":{"selector_path":{"const":"/adr/ADR-02/decision"},"allowed_values":{"const":["NO_INDEX","INDEX"]},"cases":{"type":"object","additionalProperties":false,"required":["NO_INDEX","INDEX"],"properties":{"NO_INDEX":{"$ref":"#/$defs/lifecycle"},"INDEX":{"$ref":"#/$defs/lifecycle"}}}}}]},
        "ADR02_NO_INDEX":{"allOf":[{"$ref":"#/$defs/predicate"},{"properties":{"selector_path":{"const":"/adr/ADR-02/decision"},"allowed_values":{"const":["NO_INDEX","INDEX"]},"selected_value":{"const":"NO_INDEX"}}}]},
        "ADR02_INDEX":{"allOf":[{"$ref":"#/$defs/predicate"},{"properties":{"selector_path":{"const":"/adr/ADR-02/decision"},"allowed_values":{"const":["NO_INDEX","INDEX"]},"selected_value":{"const":"INDEX"}}}]},
        "ADR11_LLM_ENABLED":{"allOf":[{"$ref":"#/$defs/predicate"},{"properties":{"selector_path":{"const":"/adr/ADR-11/decision"},"allowed_values":{"const":["LLM_ENABLED","LLM_OFF"]},"selected_value":{"const":"LLM_ENABLED"}}}]},
        "ADR11_SELECTED_PROFILE_LIFECYCLE":{"allOf":[{"$ref":"#/$defs/branchLifecycle"},{"properties":{"selector_path":{"const":"/adr/ADR-11/decision"},"allowed_values":{"const":["LLM_ENABLED","LLM_OFF"]},"cases":{"type":"object","additionalProperties":false,"required":["LLM_ENABLED","LLM_OFF"],"properties":{"LLM_ENABLED":{"$ref":"#/$defs/lifecycle"},"LLM_OFF":{"$ref":"#/$defs/lifecycle"}}}}}]},
        "ADR11_LLM_ENABLED_ADR13_REVALIDATION":{
          "type":"object","additionalProperties":false,
          "required":["kind","activation_selector_path","activation_value","false_lifecycle","base_lifecycle","revalidation_selector_path","revalidation_cases"],
          "properties":{
            "kind":{"const":"PREDICATE_WITH_REVALIDATION_BRANCH"},
            "activation_selector_path":{"const":"/adr/ADR-11/decision"},
            "activation_value":{"const":"LLM_ENABLED"},
            "false_lifecycle":{"const":"OMIT_ALL_LIFECYCLE_RECORDS"},
            "base_lifecycle":{"type":"object","additionalProperties":false,"required":["introduced_at","variant_at","expected_red_at","required_green_at"],"properties":{"introduced_at":{"$ref":"#/$defs/nodeList"},"variant_at":{"$ref":"#/$defs/optionalNodeList"},"expected_red_at":{"$ref":"#/$defs/nodeList"},"required_green_at":{"$ref":"#/$defs/nodeList"}}},
            "revalidation_selector_path":{"const":"/adr/ADR-13/decision"},
            "revalidation_cases":{"type":"object","additionalProperties":false,"required":["NO_SCHEMA_DELTA","SCHEMA_DELTA"],"properties":{"NO_SCHEMA_DELTA":{"$ref":"#/$defs/nodeList"},"SCHEMA_DELTA":{"$ref":"#/$defs/nodeList"}}}
          }
        },
        "PARSER_ROUTE_MEDIUM_ENABLED":{
          "type":"object","additionalProperties":false,
          "required":["kind","test_id_pattern","selector_path_template","operator","allowed_values","selected_value","selected_lifecycle","false_lifecycle"],
          "properties":{
            "kind":{"const":"DERIVED_ROUTE_PREDICATE"},
            "test_id_pattern":{"const":"^P-FMT(?P<route>01|02|03H|03T|04P|04D|05|06|07|08|09|10J|10X)-M$"},
            "selector_path_template":{"const":"/parser_route_manifest/routes/<route>/medium_policy"},
            "operator":{"const":"EQUALS"},
            "allowed_values":{"const":["ENABLED","DISABLED_HARD_LIMIT"]},
            "selected_value":{"const":"ENABLED"},
            "selected_lifecycle":{"$ref":"#/$defs/lifecycle"},
            "false_lifecycle":{"const":"OMIT_FIXED_TEST_AND_REQUIRE_P-DIS-<route>-M_IN_EXPANDED_TEST_IDS"}
          }
        }
      }
    },
    "tests":{"type":"array","minItems":286,"maxItems":286,"items":{"$ref":"#/$defs/test"}},
    "templates":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/template"}},
    "reference_extraction":{
      "type":"object","additionalProperties":false,
      "required":["active_sources","token_regex","ignore_sections","placeholder_tokens_are_references","range_abbreviations_allowed","negative_fixture_tokens_are_references"],
      "properties":{
        "active_sources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*\\.(md|json)$"}},
        "token_regex":{"type":"string","minLength":20},
        "ignore_sections":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "placeholder_tokens_are_references":{"const":false},
        "range_abbreviations_allowed":{"const":false},
        "negative_fixture_tokens_are_references":{"const":false}
      }
    },
    "gate_forbidden_tokens":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["BF00","NOT_SELECTED"]}},
    "validation":{
      "type":"object","additionalProperties":false,
      "required":["duplicate_concrete_ids_allowed","unresolved_references_allowed","unexpanded_enabled_templates_allowed","all_nodes_must_resolve_in_dag","condition_ids_must_resolve","free_text_conditions_allowed","branch_lifecycle_arrays_must_equal_case_union","only_selected_branch_records_allowed","registry_test_id"],
      "properties":{
        "duplicate_concrete_ids_allowed":{"const":false},
        "unresolved_references_allowed":{"const":false},
        "unexpanded_enabled_templates_allowed":{"const":false},
        "all_nodes_must_resolve_in_dag":{"const":true},
        "condition_ids_must_resolve":{"const":true},
        "free_text_conditions_allowed":{"const":false},
        "branch_lifecycle_arrays_must_equal_case_union":{"const":true},
        "only_selected_branch_records_allowed":{"const":true},
        "registry_test_id":{"const":"TESTID-S01"}
      }
    }
  },
  "x-semantic-rules":[
    "every non-null condition_id resolves to exactly one condition_definitions key",
    "for BRANCH_LIFECYCLE tests, the top-level lifecycle arrays equal the ordered de-duplicated union of all case arrays and only the selected case is active",
    "predicate selected_value belongs to allowed_values and false lifecycle emits no records",
    "PARSER_ROUTE_MEDIUM_ENABLED derives route from the full test ID, reads the exact route object, and requires the complementary P-DIS ID when disabled",
    "test IDs, template IDs and case-folded active source paths are unique"
  ]
}
