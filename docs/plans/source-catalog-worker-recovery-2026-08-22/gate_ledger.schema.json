{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:gate-ledger:v4",
  "title": "Source Catalog Worker recovery append-only Gate ledger record v4",
  "type": "object",
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^(T00L|D00L|I00L|G00L|D00|OP00|G00|T01|D01|G01|T02A|D02A|I02A|G02A|G02B-ADR|(T|D|I|G)02B-(NI|IDX)|(T|D|I|G)(03|04|05|06|06P|07E|07O|08|09P|09)|G07-ADR|G10C|D11A|OP11A|G11A|D11M|OP11M|G11M|D11J|OP11J|G11J|G11M-L-ADR|D11M-L|OP11M-L|G11M-L|(D|OP|G)11B-A[123]|(D|OP|G)11B-BP|(D|OP|G)11B-BF(0[1-9]|[1-9][0-9])|G10R|D12A|OP12A|G12A|G12B-PRE|D12B-ARM|OP12B-ARM|G12B-ARM|D12B-RB|OP12B-RB|G12B-RB|D12B-CAS|OP12B-CAS|G12B-CAS|D12B-LOGIN|OP12B-LOGIN|G12B-POST|D12C|G12C-PRE|OP12C|G12C|OP12C-RB|G12C-RB|(D|OP|G)05R(0[1-9]|[1-9][0-9]))$"
    },
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reviewer": {
      "type":"object",
      "additionalProperties":false,
      "required":[
        "reviewer_agent_id",
        "reviewer_role",
        "verdict",
        "reason_code",
        "original_payload_sha256",
        "review_payload_path",
        "review_payload_sha256",
        "stored_report_path",
        "stored_report_sha256",
        "review_confirmation_path",
        "review_confirmation_sha256",
        "reviewer_storage_hash_confirmed",
        "independence_confirmed",
        "counterexample_attempted"
      ],
      "properties": {
        "reviewer_agent_id":{"type":"string","minLength":1,"maxLength":160},
        "reviewer_role":{"enum":["design_correctness","test_correctness","ledger_schema","dag_adversarial","sql_performance","control_security","test_operations","data_integrity","runtime_operations","storage_recovery","llm_data_governance","windows_startup","release_security","rollback_operations","parser_performance","scanner_performance","evidence_privacy"]},
        "verdict":{"enum":["PASS","PASS_WITH_NONBLOCKING_FINDINGS","FAIL"]},
        "reason_code":{
          "anyOf":[
            {"type":"null"},
            {"enum":["EVIDENCE_DRIFT","NO_INDEPENDENT_REVIEW","MISSING_AUTHORIZATION","ENVIRONMENT_UNAVAILABLE","OPEN_P0_P1","SCOPE_DRIFT","COUNTEREXAMPLE_FAILED","CONTRACT_MISMATCH"]}
          ]
        },
        "original_payload_sha256":{"$ref":"#/$defs/sha256"},
        "review_payload_path":{"type":"string","pattern":"^reviews/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
        "review_payload_sha256":{"$ref":"#/$defs/sha256"},
        "stored_report_path":{"type":"string","pattern":"^reviews/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"},
        "stored_report_sha256":{"$ref":"#/$defs/sha256"},
        "review_confirmation_path":{"type":"string","pattern":"^reviews/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*-confirmation\\.json$"},
        "review_confirmation_sha256":{"$ref":"#/$defs/sha256"},
        "reviewer_storage_hash_confirmed":{"type":"boolean"},
        "independence_confirmed":{"type":"boolean"},
        "counterexample_attempted":{"type":"boolean"}
      },
      "allOf":[
        {
          "if":{"properties":{"verdict":{"enum":["PASS","PASS_WITH_NONBLOCKING_FINDINGS"]}},"required":["verdict"]},
          "then":{"properties":{"reason_code":{"const":null}}}
        },
        {
          "if":{"properties":{"verdict":{"const":"FAIL"}},"required":["verdict"]},
          "then":{"properties":{"reason_code":{"type":"string"}}}
        }
      ]
    },
    "finding": {
      "type":"object",
      "additionalProperties":false,
      "required":["finding_id","priority","owner","due_node"],
      "properties": {
        "finding_id":{"type":"string","minLength":1,"maxLength":80},
        "priority":{"enum":["P0","P1","P2","P3"]},
        "owner":{"type":"string","minLength":1,"maxLength":160},
        "due_node":{"$ref":"#/$defs/nodeId"}
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "seq",
    "prev_record_sha256",
    "recorded_at",
    "plan_revision",
    "plan_manifest_sha256",
    "gate_dag_sha256",
    "validator_release_manifest_sha256",
    "validator_version",
    "node_id",
    "node_type",
    "node_status",
    "branch_decision",
    "base_commit",
    "test_commit",
    "implementation_commit",
    "executor_agent_id",
    "operation_run_id",
    "authorization_evidence_id",
    "authorization_manifest_path",
    "authorization_manifest_sha256",
    "operation_intent_manifest_path",
    "operation_intent_manifest_sha256",
    "operation_contract_path",
    "operation_contract_sha256",
    "journal_manifest_path",
    "journal_manifest_sha256",
    "evidence_manifest_path",
    "evidence_manifest_sha256",
    "evidence_report_path",
    "evidence_report_sha256",
    "reviewers",
    "open_findings",
    "production_state_before",
    "production_state_after",
    "control_generation_before",
    "control_generation_after",
    "lifecycle_outcome",
    "supersedes_seq"
  ],
  "properties": {
    "seq":{"type":"integer","minimum":1},
    "prev_record_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "recorded_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"},
    "plan_revision":{"const":"v4"},
    "plan_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "gate_dag_sha256":{"$ref":"#/$defs/sha256"},
    "validator_release_manifest_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "validator_version":{"type":"string","pattern":"^gate-ledger-validator-v[1-9][0-9]*$"},
    "node_id":{"$ref":"#/$defs/nodeId"},
    "node_type":{"enum":["T","D","I","OP","G"]},
    "node_status":{"enum":["READY","IN_PROGRESS","PASSED","PASSED_WITH_P2","BLOCKED","INVALIDATED"]},
    "branch_decision":{
      "anyOf":[
        {"type":"null"},
        {
          "type":"object",
          "additionalProperties":false,
          "required":["decision_id","value","rationale_evidence_id"],
          "properties":{
            "decision_id":{"enum":["ADR-02","ADR-11","ADR-13"]},
            "value":{"enum":["NO_INDEX","INDEX","LLM_OFF","LLM_ENABLED","NO_SCHEMA_DELTA","SCHEMA_DELTA"]},
            "rationale_evidence_id":{"type":"string","minLength":1,"maxLength":160}
          }
        }
      ]
    },
    "base_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "test_commit":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{40}$"}]},
    "implementation_commit":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{40}$"}]},
    "executor_agent_id":{"anyOf":[{"type":"null"},{"type":"string","minLength":1,"maxLength":160}]},
    "operation_run_id":{"anyOf":[{"type":"null"},{"type":"string","minLength":8,"maxLength":160}]},
    "authorization_evidence_id":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^(NOT_APPLICABLE:[A-Z0-9_]+|[A-Za-z0-9][A-Za-z0-9._:-]{0,159})$"}]},
    "authorization_manifest_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/authorization_manifest\\.json$"}]},
    "authorization_manifest_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "operation_intent_manifest_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/operation_intent_manifest\\.json$"}]},
    "operation_intent_manifest_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "operation_contract_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/operation_contract\\.json$"}]},
    "operation_contract_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "journal_manifest_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/journal_manifest\\.json$"}]},
    "journal_manifest_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "evidence_manifest_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/manifest\\.json$"}]},
    "evidence_manifest_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "evidence_report_path":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/report\\.md$"}]},
    "evidence_report_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},
    "reviewers":{"type":"array","items":{"$ref":"#/$defs/reviewer"}},
    "open_findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},
    "production_state_before":{"enum":["NOT_APPLICABLE","PAUSED/OFF","PAUSED/ON","PAUSED/REGISTRY_CONFLICT","ARMED_PRELOGIN/OFF","ARMED_ON_PRELOGIN/ON","LOGIN_COMMITTED/ON","RUNNING_ONCE/OFF","RUNNING_SESSION/OFF","RUNNING_LOGIN_VALIDATION/ON","LOGIN_VALIDATED_PAUSED/ON","ENABLED_IDLE/ON","RUNNING_AUTOSTART/ON"]},
    "production_state_after":{"enum":["NOT_APPLICABLE","PAUSED/OFF","PAUSED/ON","PAUSED/REGISTRY_CONFLICT","ARMED_PRELOGIN/OFF","ARMED_ON_PRELOGIN/ON","LOGIN_COMMITTED/ON","RUNNING_ONCE/OFF","RUNNING_SESSION/OFF","RUNNING_LOGIN_VALIDATION/ON","LOGIN_VALIDATED_PAUSED/ON","ENABLED_IDLE/ON","RUNNING_AUTOSTART/ON"]},
    "control_generation_before":{"anyOf":[{"type":"null"},{"type":"integer","minimum":0}]},
    "control_generation_after":{"anyOf":[{"type":"null"},{"type":"integer","minimum":0}]},
    "lifecycle_outcome":{"enum":["NOT_APPLICABLE","SAFE_PAUSED_WAITING_USER","RECOVERED","ROLLED_BACK"]},
    "supersedes_seq":{"anyOf":[{"type":"null"},{"type":"integer","minimum":1}]}
  },
  "allOf": [
    {"if":{"properties":{"node_id":{"pattern":"^T"}},"required":["node_id"]},"then":{"properties":{"node_type":{"const":"T"}}}},
    {"if":{"properties":{"node_id":{"pattern":"^D"}},"required":["node_id"]},"then":{"properties":{"node_type":{"const":"D"}}}},
    {"if":{"properties":{"node_id":{"pattern":"^I"}},"required":["node_id"]},"then":{"properties":{"node_type":{"const":"I"}}}},
    {"if":{"properties":{"node_id":{"pattern":"^OP"}},"required":["node_id"]},"then":{"properties":{"node_type":{"const":"OP"}}}},
    {"if":{"properties":{"node_id":{"pattern":"^G"}},"required":["node_id"]},"then":{"properties":{"node_type":{"const":"G"}}}},

    {
      "if":{"properties":{"node_status":{"enum":["READY","IN_PROGRESS"]}},"required":["node_status"]},
      "then":{"properties":{"reviewers":{"maxItems":0},"open_findings":{"maxItems":0},"authorization_manifest_path":{"type":"null"},"authorization_manifest_sha256":{"type":"null"},"operation_intent_manifest_path":{"type":"null"},"operation_intent_manifest_sha256":{"type":"null"},"operation_contract_path":{"type":"null"},"operation_contract_sha256":{"type":"null"},"journal_manifest_path":{"type":"null"},"journal_manifest_sha256":{"type":"null"},"evidence_manifest_path":{"type":"null"},"evidence_manifest_sha256":{"type":"null"},"evidence_report_path":{"type":"null"},"evidence_report_sha256":{"type":"null"},"lifecycle_outcome":{"const":"NOT_APPLICABLE"},"supersedes_seq":{"type":"null"}}}
    },
    {
      "if":{"properties":{"node_status":{"const":"PASSED"}},"required":["node_status"]},
      "then":{"properties":{"evidence_manifest_path":{"type":"string"},"evidence_manifest_sha256":{"$ref":"#/$defs/sha256"},"evidence_report_path":{"type":"string"},"evidence_report_sha256":{"$ref":"#/$defs/sha256"},"open_findings":{"maxItems":0},"supersedes_seq":{"type":"null"}}}
    },
    {
      "if":{"properties":{"node_type":{"enum":["D","G"]},"node_status":{"const":"PASSED"}},"required":["node_type","node_status"]},
      "then":{
        "properties":{
          "executor_agent_id":{"type":"null"},
          "reviewers":{
            "minItems":1,
            "items":{
              "allOf":[
                {"$ref":"#/$defs/reviewer"},
                {"properties":{"verdict":{"const":"PASS"},"reason_code":{"const":null},"reviewer_storage_hash_confirmed":{"const":true},"independence_confirmed":{"const":true},"counterexample_attempted":{"const":true}}}
              ]
            }
          }
        }
      }
    },
    {
      "if":{"properties":{"node_type":{"enum":["T","I","OP"]},"node_status":{"const":"PASSED"}},"required":["node_type","node_status"]},
      "then":{"properties":{"executor_agent_id":{"type":"string"},"reviewers":{"maxItems":0}}}
    },
    {
      "if":{"properties":{"node_status":{"const":"PASSED_WITH_P2"}},"required":["node_status"]},
      "then":{
        "properties":{
          "node_type":{"enum":["D","G"]},
          "executor_agent_id":{"type":"null"},
          "evidence_manifest_path":{"type":"string"},
          "evidence_manifest_sha256":{"$ref":"#/$defs/sha256"},
          "evidence_report_path":{"type":"string"},
          "evidence_report_sha256":{"$ref":"#/$defs/sha256"},
          "open_findings":{
            "minItems":1,
            "items":{"allOf":[{"$ref":"#/$defs/finding"},{"properties":{"priority":{"enum":["P2","P3"]}}}]}
          },
          "reviewers":{
            "minItems":1,
            "contains":{"properties":{"verdict":{"const":"PASS_WITH_NONBLOCKING_FINDINGS"}},"required":["verdict"]},
            "minContains":1,
            "items":{
              "allOf":[
                {"$ref":"#/$defs/reviewer"},
                {"properties":{"verdict":{"enum":["PASS","PASS_WITH_NONBLOCKING_FINDINGS"]},"reason_code":{"const":null},"reviewer_storage_hash_confirmed":{"const":true},"independence_confirmed":{"const":true},"counterexample_attempted":{"const":true}}}
              ]
            }
          },
          "supersedes_seq":{"type":"null"}
        }
      }
    },
    {
      "if":{"properties":{"open_findings":{"contains":{"properties":{"priority":{"enum":["P0","P1"]}},"required":["priority"]}}},"required":["open_findings"]},
      "then":{"properties":{"node_status":{"const":"BLOCKED"}}}
    },
    {
      "if":{"properties":{"node_status":{"const":"INVALIDATED"}},"required":["node_status"]},
      "then":{"properties":{"supersedes_seq":{"type":"integer","minimum":1}}}
    },
    {
      "if":{"properties":{"node_type":{"const":"T"},"node_status":{"const":"PASSED"}},"required":["node_type","node_status"]},
      "then":{"properties":{"test_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}}
    },
    {
      "if":{"properties":{"node_type":{"const":"I"},"node_status":{"const":"PASSED"}},"required":["node_type","node_status"]},
      "then":{"properties":{"implementation_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}}
    },
    {
      "if":{"properties":{"node_type":{"const":"OP"},"node_status":{"const":"PASSED"}},"required":["node_type","node_status"]},
      "then":{"properties":{"operation_run_id":{"type":"string"},"authorization_evidence_id":{"type":"string"},"authorization_manifest_path":{"type":"string"},"authorization_manifest_sha256":{"$ref":"#/$defs/sha256"},"operation_intent_manifest_path":{"type":"string"},"operation_intent_manifest_sha256":{"$ref":"#/$defs/sha256"},"operation_contract_path":{"type":"string"},"operation_contract_sha256":{"$ref":"#/$defs/sha256"},"production_state_before":{"not":{"const":"NOT_APPLICABLE"}},"production_state_after":{"not":{"const":"NOT_APPLICABLE"}},"control_generation_before":{"type":"integer"},"control_generation_after":{"type":"integer"}}}
    },

    {
      "if":{"properties":{"node_id":{"enum":["G10C","G10R","G12C-PRE","G12C"]},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"reviewers":{"minItems":3,"maxItems":3}}}
    },
    {
      "if":{"properties":{"node_id":{"pattern":"^(G00L|G02A|G02B-ADR|D02B-(NI|IDX)|G02B-(NI|IDX)|D05|G05|(D|G)05R(0[1-9]|[1-9][0-9])|G07-ADR|D07E|G07E|D09P|G09P|D09|G09|D11A|G11A|D11M|G11M|D11J|G11J|G11M-L-ADR|D11M-L|G11M-L|(D|G)11B-A[123]|(D|G)11B-BP|(D|G)11B-BF(0[1-9]|[1-9][0-9])|D12A|G12A|G12B-PRE|D12B-ARM|G12B-ARM|D12B-RB|G12B-RB|D12B-CAS|G12B-CAS|D12B-LOGIN|G12B-POST|D12C|G12C-RB)$"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"reviewers":{"minItems":2,"maxItems":2}}}
    },
    {
      "if":{
        "properties":{
          "node_type":{"enum":["D","G"]},
          "node_status":{"enum":["PASSED","PASSED_WITH_P2"]},
          "node_id":{"not":{"anyOf":[
            {"enum":["G10C","G10R","G12C-PRE","G12C"]},
            {"pattern":"^(G00L|G02A|G02B-ADR|D02B-(NI|IDX)|G02B-(NI|IDX)|D05|G05|(D|G)05R(0[1-9]|[1-9][0-9])|G07-ADR|D07E|G07E|D09P|G09P|D09|G09|D11A|G11A|D11M|G11M|D11J|G11J|G11M-L-ADR|D11M-L|G11M-L|(D|G)11B-A[123]|(D|G)11B-BP|(D|G)11B-BF(0[1-9]|[1-9][0-9])|D12A|G12A|G12B-PRE|D12B-ARM|G12B-ARM|D12B-RB|G12B-RB|D12B-CAS|G12B-CAS|D12B-LOGIN|G12B-POST|D12C|G12C-RB)$"}
          ]}}
        },
        "required":["node_type","node_status","node_id"]
      },
      "then":{"properties":{"reviewers":{"minItems":1,"maxItems":1}}}
    },

    {
      "if":{"properties":{"node_id":{"const":"G02B-ADR"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"branch_decision":{"type":"object","properties":{"decision_id":{"const":"ADR-02"},"value":{"enum":["NO_INDEX","INDEX"]}},"required":["decision_id","value","rationale_evidence_id"]}}}
    },
    {
      "if":{"properties":{"node_id":{"const":"G07-ADR"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"branch_decision":{"type":"object","properties":{"decision_id":{"const":"ADR-11"},"value":{"enum":["LLM_OFF","LLM_ENABLED"]}},"required":["decision_id","value","rationale_evidence_id"]}}}
    },
    {
      "if":{"properties":{"node_id":{"const":"G11M-L-ADR"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"branch_decision":{"type":"object","properties":{"decision_id":{"const":"ADR-13"},"value":{"enum":["NO_SCHEMA_DELTA","SCHEMA_DELTA"]}},"required":["decision_id","value","rationale_evidence_id"]}}}
    },
    {
      "if":{"properties":{"node_id":{"not":{"enum":["G02B-ADR","G07-ADR","G11M-L-ADR"]}}},"required":["node_id"]},
      "then":{"properties":{"branch_decision":{"type":"null"}}}
    },
    {
      "if":{"properties":{"evidence_manifest_path":{"type":"string"}},"required":["evidence_manifest_path"]},
      "then":{"properties":{"evidence_manifest_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"evidence_manifest_path":{"type":"null"}},"required":["evidence_manifest_path"]},
      "then":{"properties":{"evidence_manifest_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"authorization_manifest_path":{"type":"string"}},"required":["authorization_manifest_path"]},
      "then":{"properties":{"authorization_manifest_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"authorization_manifest_path":{"type":"null"}},"required":["authorization_manifest_path"]},
      "then":{"properties":{"authorization_manifest_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"operation_intent_manifest_path":{"type":"string"}},"required":["operation_intent_manifest_path"]},
      "then":{"properties":{"operation_intent_manifest_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"operation_intent_manifest_path":{"type":"null"}},"required":["operation_intent_manifest_path"]},
      "then":{"properties":{"operation_intent_manifest_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"operation_contract_path":{"type":"string"}},"required":["operation_contract_path"]},
      "then":{"properties":{"operation_contract_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"operation_contract_path":{"type":"null"}},"required":["operation_contract_path"]},
      "then":{"properties":{"operation_contract_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"journal_manifest_path":{"type":"string"}},"required":["journal_manifest_path"]},
      "then":{"properties":{"journal_manifest_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"journal_manifest_path":{"type":"null"}},"required":["journal_manifest_path"]},
      "then":{"properties":{"journal_manifest_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"evidence_report_path":{"type":"string"}},"required":["evidence_report_path"]},
      "then":{"properties":{"evidence_report_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"evidence_report_path":{"type":"null"}},"required":["evidence_report_path"]},
      "then":{"properties":{"evidence_report_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"node_id":{"enum":["OP00","OP11A"]},"node_status":{"const":"PASSED"}},"required":["node_id","node_status"]},
      "then":{"properties":{"journal_manifest_path":{"type":"null"},"journal_manifest_sha256":{"type":"null"}}}
    },
    {
      "if":{"properties":{"node_type":{"const":"OP"},"node_id":{"not":{"enum":["OP00","OP11A"]}},"node_status":{"const":"PASSED"}},"required":["node_type","node_id","node_status"]},
      "then":{"properties":{"journal_manifest_path":{"type":"string"},"journal_manifest_sha256":{"$ref":"#/$defs/sha256"}}}
    },
    {
      "if":{"properties":{"node_id":{"not":{"enum":["G12B-POST","G12B-RB","G12C","G12C-RB"]}}},"required":["node_id"]},
      "then":{"properties":{"lifecycle_outcome":{"const":"NOT_APPLICABLE"}}}
    },
    {
      "if":{"properties":{"node_id":{"const":"G12B-POST"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"production_state_before":{"const":"LOGIN_VALIDATED_PAUSED/ON"},"production_state_after":{"const":"LOGIN_VALIDATED_PAUSED/ON"},"lifecycle_outcome":{"const":"SAFE_PAUSED_WAITING_USER"}}}
    },
    {
      "if":{"properties":{"node_id":{"const":"G12C-PRE"},"node_status":{"enum":["PASSED","PASSED_WITH_P2"]}},"required":["node_id","node_status"]},
      "then":{"properties":{"production_state_before":{"const":"LOGIN_VALIDATED_PAUSED/ON"},"production_state_after":{"const":"LOGIN_VALIDATED_PAUSED/ON"},"lifecycle_outcome":{"const":"NOT_APPLICABLE"}}}
    },
    {
      "if":{"properties":{"node_id":{"const":"OP12C"},"node_status":{"const":"PASSED"}},"required":["node_id","node_status"]},
      "then":{"properties":{"production_state_before":{"const":"LOGIN_VALIDATED_PAUSED/ON"},"production_state_after":{"const":"ENABLED_IDLE/ON"},"lifecycle_outcome":{"const":"NOT_APPLICABLE"}}}
