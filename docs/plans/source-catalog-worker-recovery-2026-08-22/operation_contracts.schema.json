{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:operation-policy-instance:v4",
  "title":"Static operation policy catalog schema",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["operation","authorization_policy","required_authorization_kind","intent_policy","journal_policy","registry_contract_mode","evidence_manifest_required","dynamic_contract_required","generation_deltas","db_effect","file_effect","registry_effect","egress"],
      "properties":{
        "node":{"type":"string","minLength":3,"maxLength":32},
        "node_pattern":{"type":"string","minLength":3,"maxLength":200},
        "operation":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
        "authorization_policy":{"enum":["REQUIRED","N_A_ALLOWED","BOUND_COMPENSATION"]},
        "required_authorization_kind":{"enum":["NOT_APPLICABLE_LOCAL_READ_ONLY","STAGE_BOUND_OPERATION","BOUND_COMPENSATION","CIRCUIT_RESET"]},
        "intent_policy":{"enum":["REQUIRED_READ_ONLY","REQUIRED_MUTATION","REQUIRED_COMPENSATION","REQUIRED_RESET"]},
        "journal_policy":{"enum":["NOT_APPLICABLE","INITIALIZE","REQUIRED_INTENT_FINALIZE"]},
        "registry_contract_mode":{"enum":["NONE","VERIFY_ONLY_EXACT_OWNED_VALUE","EXACT_CAS_CREATE_ABSENT","VERIFY_ABSENT_OR_CONDITIONAL_DELETE_EXACT_OWNED_PRESERVE_CONFLICT","VERIFY_OR_PRESERVE_CONFLICT"]},
        "evidence_manifest_required":{"const":true},
        "allowed_na_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"}},
        "dynamic_contract_required":{"type":"boolean"},
        "per_cycle_subcontract_required":{"type":"boolean"},
        "state_sequence":{"type":"array","minItems":2,"items":{"type":"string","minLength":3,"maxLength":80}},
        "state_sequence_options":{"type":"array","minItems":1,"items":{"type":"array","minItems":2,"items":{"type":"string","minLength":3,"maxLength":80}}},
        "generation_deltas":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0,"maximum":1}},
        "db_effect":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
        "file_effect":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
        "registry_effect":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
        "egress":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
        "contract_requires":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"}}
      },
      "oneOf":[{"required":["node"]},{"required":["node_pattern"]}],
      "anyOf":[{"required":["state_sequence"]},{"required":["state_sequence_options"]}],
      "allOf":[
        {"if":{"properties":{"authorization_policy":{"const":"N_A_ALLOWED"}},"required":["authorization_policy"]},"then":{"required":["allowed_na_reasons"],"properties":{"allowed_na_reasons":{"minItems":1}}}},
        {"if":{"properties":{"authorization_policy":{"not":{"const":"N_A_ALLOWED"}}},"required":["authorization_policy"]},"then":{"properties":{"allowed_na_reasons":{"maxItems":0}}}},
        {"if":{"properties":{"authorization_policy":{"const":"N_A_ALLOWED"}},"required":["authorization_policy"]},"then":{"properties":{"required_authorization_kind":{"const":"NOT_APPLICABLE_LOCAL_READ_ONLY"},"intent_policy":{"const":"REQUIRED_READ_ONLY"},"journal_policy":{"const":"NOT_APPLICABLE"}}}},
        {"if":{"properties":{"authorization_policy":{"const":"BOUND_COMPENSATION"}},"required":["authorization_policy"]},"then":{"properties":{"required_authorization_kind":{"const":"BOUND_COMPENSATION"},"intent_policy":{"const":"REQUIRED_COMPENSATION"},"journal_policy":{"const":"REQUIRED_INTENT_FINALIZE"}}}},
        {"if":{"properties":{"required_authorization_kind":{"const":"CIRCUIT_RESET"}},"required":["required_authorization_kind"]},"then":{"properties":{"intent_policy":{"const":"REQUIRED_RESET"},"journal_policy":{"const":"REQUIRED_INTENT_FINALIZE"}}}}
      ]
    }
  },
  "required":["schema_id","contract","plan_revision","dynamic_contract_schema","operation_intent_schema","operation_intent_template_schema","authorization_schema","journal_manifest_schema","evidence_manifest_schema","default_invariants","authorization_policies","operations","families","ordinary_autostart_transition","runtime_cycle_policy"],
  "properties":{
    "schema_id":{"const":"urn:company-wiki:source-catalog-worker-recovery:operation-policy-instance:v4"},
    "contract":{"const":"source-catalog-worker-recovery-operation-policy-catalog"},
    "plan_revision":{"const":"v4"},
    "dynamic_contract_schema":{"const":"operation_contract.schema.json"},
    "operation_intent_schema":{"const":"operation_intent_manifest.schema.json"},
    "operation_intent_template_schema":{"const":"operation_intent_template.schema.json"},
    "authorization_schema":{"const":"authorization_manifest.schema.json"},
    "journal_manifest_schema":{"const":"journal_manifest.schema.json"},
    "evidence_manifest_schema":{"const":"evidence_manifest.schema.json"},
    "default_invariants":{
      "type":"object","additionalProperties":false,
      "required":["circuit_must_be_closed_unless_operation_is_reset","process_count_before","process_count_after","source_mutation_count","config_mutation_count","unexpected_db_operation_count","unexpected_file_operation_count","unexpected_egress_count","ordinary_open_may_run_ddl","contract_expansion_after_seal_allowed","intent_hash_binding_required","authorization_kind_exact_match","journal_head_binding_required_for_mutation","evidence_manifest_machine_readable","registry_write_requires_machine_contract"],
      "properties":{
        "circuit_must_be_closed_unless_operation_is_reset":{"const":true},
        "process_count_before":{"const":0},"process_count_after":{"const":0},
        "source_mutation_count":{"const":0},"config_mutation_count":{"const":0},
        "unexpected_db_operation_count":{"const":0},"unexpected_file_operation_count":{"const":0},
        "unexpected_egress_count":{"const":0},"ordinary_open_may_run_ddl":{"const":false},
        "contract_expansion_after_seal_allowed":{"const":false},
        "intent_hash_binding_required":{"const":true},
        "authorization_kind_exact_match":{"const":true},
        "journal_head_binding_required_for_mutation":{"const":true},
        "evidence_manifest_machine_readable":{"const":true},
        "registry_write_requires_machine_contract":{"const":true}
      }
    },
    "authorization_policies":{"type":"object","required":["REQUIRED","N_A_ALLOWED","BOUND_COMPENSATION"],"additionalProperties":false,"properties":{"REQUIRED":{"type":"string","minLength":1},"N_A_ALLOWED":{"type":"string","minLength":1},"BOUND_COMPENSATION":{"type":"string","minLength":1}}},
    "operations":{"type":"array","minItems":15,"items":{"$ref":"#/$defs/policy"}},
    "families":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/policy"}},
    "ordinary_autostart_transition":{"type":"object","required":["from_state","to_state","requires","failure_state","conflict_failure_state","forbid_if_lifecycle_outcome_not_recovered"],"additionalProperties":false,"properties":{"from_state":{"const":"ENABLED_IDLE/ON"},"to_state":{"const":"RUNNING_AUTOSTART/ON"},"requires":{"const":["G12C_PASSED","CIRCUIT_CLOSED","EXACT_RELEASE_AUTH_CONFIG_ROUTING_DATA_HASHES","UNCHANGED_EXACT_RUN_VALUE","JOB_OBJECT_AND_SINGLE_INSTANCE","CURRENT_USER_SID_MATCH","NEW_LOGON_RELATION_VALID","SEALED_RUNTIME_CYCLE_INTENT_AND_CONTRACT","VALID_AUTHORIZATION_AND_DURABLE_BUDGETS","VALID_JOURNAL_HEAD"]},"failure_state":{"const":"PAUSED/ON"},"conflict_failure_state":{"const":"PAUSED/REGISTRY_CONFLICT"},"forbid_if_lifecycle_outcome_not_recovered":{"const":true}}},
    "runtime_cycle_policy":{
      "type":"object","additionalProperties":false,
      "required":["applies_after_gate","operation_policy_id","cycle_contract_schema","cycle_intent_action_id","required_authorization_kind","authorization_intent_binding_mode","authorization_template_schema","journal_policy","seal_before_any_side_effect","required_bindings","revalidate_before_each_cycle","durable_budget_scopes","budget_reservation_policy","budget_settlement_policy","success_state","failure_state","conflict_failure_state","failure_actions","process_count_after","forbidden_mutations_on_preflight_failure"],
      "properties":{
        "applies_after_gate":{"const":"G12C"},
        "operation_policy_id":{"const":"OP-RUNTIME-CYCLE"},
        "cycle_contract_schema":{"const":"operation_contract.schema.json"},
        "cycle_intent_action_id":{"const":"ORDINARY_AUTOSTART_CYCLE"},
        "required_authorization_kind":{"const":"STAGE_BOUND_OPERATION"},
        "authorization_intent_binding_mode":{"const":"RUNTIME_TEMPLATE_SPECIALIZATION"},
        "authorization_template_schema":{"const":"operation_intent_template.schema.json"},
        "journal_policy":{"const":"REQUIRED_INTENT_FINALIZE"},
        "seal_before_any_side_effect":{"const":true},
        "required_bindings":{"const":["PROCESS_GENERATION","CONTROL_GENERATION","CIRCUIT_GENERATION","RELEASE_HASH","CONFIG_HASH","ROUTING_HASH","DATA_IDENTITY_HASH","AUTHORIZATION_HASH","AUTHORIZATION_TEMPLATE_HASH","RUNTIME_POLICY_HASH","FRESH_EXACT_INTENT_HASH","INTENT_SPECIALIZATION_PROOF","JOURNAL_HEAD_BEFORE","EXACT_CANDIDATE_SOURCES","EXACT_DB_WRITES","EXACT_FILE_WRITES","EXACT_EGRESS","FOUR_DURABLE_BUDGET_RESERVATIONS"]},
        "revalidate_before_each_cycle":{"const":["AUTH_NOT_EXPIRED_NOT_REVOKED","AUTH_TEMPLATE_AND_SCOPE_MATCH","FRESH_INTENT_STRICT_SPECIALIZATION","RELEASE_CONFIG_ROUTING_DATA_GENERATIONS_MATCH","DAILY_CAP_AVAILABLE","MONTHLY_CAP_AVAILABLE","CIRCUIT_CLOSED","REGISTRY_VALUE_EXACT_AND_OWNED","SINGLE_INSTANCE","JOURNAL_HEAD_MATCH","BUDGET_RESERVATIONS_DURABLE_BEFORE_EGRESS"]},
        "durable_budget_scopes":{"const":["DAILY_PROVIDER_REQUESTS","DAILY_PROVIDER_COST_MINOR_UNITS","MONTHLY_PROVIDER_REQUESTS","MONTHLY_PROVIDER_COST_MINOR_UNITS"]},
        "budget_reservation_policy":{"const":"EXACTLY_ONE_PER_SCOPE_ATOMIC_BEFORE_EGRESS"},
        "budget_settlement_policy":{"const":"SETTLE_ONCE_OR_RETAIN_MAX_ON_OUTCOME_UNKNOWN"},
        "success_state":{"const":"ENABLED_IDLE/ON"},
        "failure_state":{"const":"PAUSED/ON"},
        "conflict_failure_state":{"const":"PAUSED/REGISTRY_CONFLICT"},
        "failure_actions":{"const":["OPEN_CIRCUIT","SET_PAUSED","ENSURE_PROCESS_ZERO","FINALIZE_OR_RECONCILE_JOURNAL"]},
        "process_count_after":{"const":0},
        "forbidden_mutations_on_preflight_failure":{"const":["REGISTRY","CONFIG","SOURCE_DOCUMENTS","CATALOG_DB","NORMALIZED_OUTPUT"]}
      }
    }
  }
}
