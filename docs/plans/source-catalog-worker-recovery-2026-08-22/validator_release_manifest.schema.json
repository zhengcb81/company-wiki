{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:validator-release-manifest:v1",
  "title":"Hermetic gate-ledger validator release manifest",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "utc":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"},
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["path","sha256","size_bytes"],
      "properties":{
        "path":{"type":"string","minLength":1,"maxLength":1024},
        "sha256":{"$ref":"#/$defs/sha256"},
        "size_bytes":{"type":"integer","minimum":1}
      }
    }
  },
  "required":[
    "schema_version","plan_revision","generated_at","implementation_commit",
    "plan_manifest_sha256","gate_dag_sha256","validator_entrypoint","validator_tests",
    "interpreter","dependency_lock_sha256","distributions","environment_policy",
    "schema_runtime_probe","self_test_vectors_sha256"
  ],
  "properties":{
    "schema_version":{"const":"validator-release-manifest-v1"},
    "plan_revision":{"const":"v4"},
    "generated_at":{"$ref":"#/$defs/utc"},
    "implementation_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "plan_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "gate_dag_sha256":{"$ref":"#/$defs/sha256"},
    "validator_entrypoint":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"path":{"const":"scripts/validate_gate_ledger.py"}}}]},
    "validator_tests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/artifact"}},
    "interpreter":{
      "type":"object","additionalProperties":false,
      "required":["absolute_path","version","binary_sha256","size_bytes","launch_flags","isolated_mode","site_enabled","expected_sys_path"],
      "properties":{
        "absolute_path":{"type":"string","minLength":3,"maxLength":1024},
        "version":{"type":"string","pattern":"^3\\.[0-9]+\\.[0-9]+$"},
        "binary_sha256":{"$ref":"#/$defs/sha256"},
        "size_bytes":{"type":"integer","minimum":1},
        "launch_flags":{"const":["-I"]},
        "isolated_mode":{"const":true},
        "site_enabled":{"const":true},
        "expected_sys_path":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}}
      }
    },
    "dependency_lock_sha256":{"$ref":"#/$defs/sha256"},
    "distributions":{
      "type":"array","minItems":2,"uniqueItems":true,
      "contains":{"type":"object","properties":{"name":{"const":"jsonschema"}},"required":["name"]},
      "minContains":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["name","version","source_wheel_sha256","installed_tree_sha256","import_modules"],
        "properties":{
          "name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "version":{"type":"string","minLength":1,"maxLength":80},
          "source_wheel_sha256":{"$ref":"#/$defs/sha256"},
          "installed_tree_sha256":{"$ref":"#/$defs/sha256"},
          "import_modules":{
            "type":"array","minItems":1,"uniqueItems":true,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["module","resolved_path","sha256"],
              "properties":{
                "module":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.]*$"},
                "resolved_path":{"type":"string","minLength":1,"maxLength":1024},
                "sha256":{"$ref":"#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "environment_policy":{
      "type":"object","additionalProperties":false,
      "required":["network_allowed","dynamic_import_allowed","project_business_import_allowed","plugin_loading_allowed","unexpected_distribution_count","unexpected_sys_path_count"],
      "properties":{
        "network_allowed":{"const":false},
        "dynamic_import_allowed":{"const":false},
        "project_business_import_allowed":{"const":false},
        "plugin_loading_allowed":{"const":false},
        "unexpected_distribution_count":{"const":0},
        "unexpected_sys_path_count":{"const":0}
      }
    },
    "schema_runtime_probe":{
      "type":"object","additionalProperties":false,
      "required":["draft","format_checker_enabled","format_negative_passed","external_ref_hash_check_passed","tampered_dependency_negative_passed","unexpected_sys_path_negative_passed"],
      "properties":{
        "draft":{"const":"2020-12"},
        "format_checker_enabled":{"const":true},
        "format_negative_passed":{"const":true},
        "external_ref_hash_check_passed":{"const":true},
        "tampered_dependency_negative_passed":{"const":true},
        "unexpected_sys_path_negative_passed":{"const":true}
      }
    },
    "self_test_vectors_sha256":{"$ref":"#/$defs/sha256"}
  },
  "x-semantic-rules":[
    "distribution names and import module names are unique after case-folding",
    "distributions are the complete transitive dependency closure and exactly match the frozen lock",
    "every resolved module path is beneath an expected sys.path entry in the dedicated validator environment",
    "all artifact, installed-tree, wheel, interpreter, schema and vector hashes are recomputed from actual bytes by G00L reviewers",
    "validator release manifest is created only after I00L implementation bytes exist and is immutable for the reviewed release"
  ]
}
