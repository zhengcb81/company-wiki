{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:review-storage-confirmation:v4",
  "title":"Reviewer read-back confirmation for stored review artifacts",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","node_id","reviewer_agent_id","review_payload_path","review_payload_sha256",
    "stored_report_path","stored_report_sha256","evidence_manifest_path","evidence_manifest_sha256",
    "validator_release_manifest_sha256","input_ledger_head_sha256","storage_hash_confirmed",
    "independence_confirmed","confirmed_at"
  ],
  "properties":{
    "schema_version":{"const":"review-storage-confirmation-v1"},
    "node_id":{"allOf":[{"$ref":"gate_ledger.schema.json#/$defs/nodeId"},{"type":"string","pattern":"^[DG]"}]},
    "reviewer_agent_id":{"type":"string","minLength":1,"maxLength":160},
    "review_payload_path":{"type":"string","pattern":"^reviews/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
    "review_payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stored_report_path":{"type":"string","pattern":"^reviews/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"},
    "stored_report_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evidence_manifest_path":{"type":"string","pattern":"^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/manifest\\.json$"},
    "evidence_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "validator_release_manifest_sha256":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{64}$"}]},
    "input_ledger_head_sha256":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{64}$"}]},
    "storage_hash_confirmed":{"const":true},
    "independence_confirmed":{"const":true},
    "confirmed_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"}
  },
  "allOf":[
    {
      "if":{"properties":{"node_id":{"const":"D00L"}},"required":["node_id"]},
      "then":{"properties":{"input_ledger_head_sha256":{"type":"null"},"validator_release_manifest_sha256":{"type":"null"}}},
      "else":{"properties":{"input_ledger_head_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"validator_release_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
    }
  ]
}
