      ],
      "topics": [
        "business_revenue_recognition"
      ],
      "reading": "{'priority': 2, 'topics': ('business_revenue_recognition',), 'context_only': False, 'value_band': 'meaningful_fact', 'required': ('urn:company-wiki:narrative-unit:sha256:4832a5459e1fe6dbd72c5db8e4495c0fef2409c22265809ff421e958e23e646e', 'urn:company-wiki:narrative-unit:sha256:7a8c51487dc7028187da23f76a305b5bfc8839d7c4fcf1d8fd7d2c8a07ae6dbc'), 'fact_purpose': 'operating', 'fact_reasons': ('business_revenue_recognition',), 'package_ids': ('native-continuity:ff2ed89c91e74157d93d458d7c966db701a0954ef09de4dbe3d4762af60a42ed',)}"
