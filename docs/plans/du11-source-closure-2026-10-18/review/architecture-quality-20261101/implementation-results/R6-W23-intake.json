  "light_probe_reproducer_source": "from __future__ import annotations\nimport importlib.util,json,os,subprocess,sys,time,types\nfrom pathlib import Path\nROOT=Path(__file__).resolve().parent\n\ndef load():\n    pkg=types.ModuleType('r6_w23');pkg.__path__=[str(ROOT/'copied')];sys.modules[pkg.__name__]=pkg\n    name='r6_w23.campaign';spec=importlib.util.spec_from_file_location(name,ROOT/'copied/campaign.py');m=importlib.util.module_from_spec(spec);sys.modules[name]=m;spec.loader.exec_module(m)\n    mod=types.ModuleType('r6_w23.run_x1')\n    mod._model_dir=lambda path: Path(path)\n    def stub(pages,**kw):\n        counter=ROOT/(os.environ['CASE']+'-runner-calls.jsonl')\n        with counter.open('a',encoding='utf8') as f:f.write(json.dumps({'total_budget':kw['total_budget'],'deadline':kw['deadline']})+'\\n')\n        if kw['total_budget']<=0:raise ValueError('stub mirrors real validate_card_limits(total_budget=0)')\n        if os.environ.get('STUB_FAIL')=='1':\n            time.sleep(.025)\n            raise RuntimeError('intentional failure after started work before batch return')\n        return {'records':[{'page_id':p['page_id'],'status':'ok','text':'probe-only','request_seconds':1.0} for p in pages],\n                'identity':kw['backend_identity'], 'receipt':{'child':{'events':[{'event':'stage','stage':'page_start','page_id':p['page_id']} for p in pages]}}}\n    mod.run_x1_batch=stub;sys.modules[mod.__name__]=mod\n    b=types.ModuleType('r6_w23.backends');b.__path__=[];sys.modules[b.__name__]=b\n    x=types.ModuleType('r6_w23.backends.xiaomi_x1')\n    class IdentityOnly:\n        def __init__(self,**kw):self.identity_manifest={'arm':'X1','prompt_sha256':'probe-only','max_new_tokens':kw['max_new_tokens'],'weights_mode':kw['weights_mode']}\n    x.XiaomiX1=IdentityOnly;sys.modules[x.__name__]=x\n    return m\n\ndef worker():\n    m=load();case=os.environ['CASE'];path=ROOT/(case+'-ledger.json');ledger=m.load_ledger(path)\n    out=m.run_campaign_batch(ledger_path=path,ledger=ledger,arm='X1F',pages=[{'page_id':'p1','png_sha256':'a'*64}],cache_dir=ROOT/(case+'-cache'),model_dir=str(ROOT/'dummy-model'))\n    (ROOT/(case+'-batch.json')).write_text(json.dumps(out),encoding='utf8')\n\ndef run(case,fail=False):\n    env={**os.environ,'CASE':case,'STUB_FAIL':'1' if fail else '0'}\n    p=subprocess.run([sys.executable,'-B','-I','-X','utf8',str(__file__),'worker'],env=env,cwd=str(ROOT),capture_output=True,text=True,encoding='utf8',errors='replace',timeout=15)\n    return {'returncode':p.returncode,'stderr_tail':p.stderr[-500:]}\n\ndef calls(case):\n    path=ROOT/(case+'-runner-calls.jsonl');return [json.loads(x) for x in path.read_text('utf8').splitlines()] if path.exists() else []\n\ndef main():\n    m=load();cases=[]\n    path=ROOT/'resume-ledger.json';m.create_ledger(path,plan_id='probe',budget_seconds=500)\n    r1=run('resume');before=m.load_ledger(path);r2=run('resume');after=m.load_ledger(path);batch=json.loads((ROOT/'resume-batch.json').read_text('utf8'))\n    cases.append({'id':'real-x1-cross-process-cache','expected':'fresh process resumes same cached page with zero backend calls and no re-charge','first':r1,'second':r2,'backend_calls':len(calls('resume')),'spent_before':before['spent_seconds'],'spent_after':after['spent_seconds'],'second_cache_hit':batch['records'][0].get('cache_hit'), 'verdict':'FAIL' if len(calls('resume'))!=1 or before['spent_seconds']!=after['spent_seconds'] else 'PASS'})\n    path=ROOT/'inflight-ledger.json';m.create_ledger(path,plan_id='probe',budget_seconds=500);failed=run('inflight',True);afterfail=m.load_ledger(path);recovery=run('inflight');afterresume=m.load_ledger(path)\n    cases.append({'id':'real-x1-unknown-inflight-recovery','expected':'started failed invocation conservatively reserved/charged before new process resumes','failed':failed,'after_failure':afterfail,'recovery':recovery,'backend_calls':len(calls('inflight')),'spent_after_resume':afterresume['spent_seconds'],'verdict':'FAIL' if afterfail['spent_seconds']==0 and not any('pending' in str(k) or 'inflight' in str(k) for k in afterfail) else 'PASS'})\n    path=ROOT/'exhausted-ledger.json';m.create_ledger(path,plan_id='probe',budget_seconds=1);m.record(m.load_ledger(path),path,arm='X1F',page_id='old',seconds=1,status='ok');zero=run('exhausted')\n    cases.append({'id':'real-x1-zero-balance-denominator','expected':'return not_run full denominator before model identity/runner with zero backend calls','result':zero,'runner_calls':calls('exhausted'),'verdict':'FAIL' if calls('exhausted') or zero['returncode'] else 'PASS'})\n    path=ROOT/'nonfinite-ledger.json';d={'schema_version':m.LEDGER_SCHEMA,'budget_seconds':float('nan'),'spent_seconds':0,'entries':[]};path.write_text(json.dumps(d),encoding='utf8')\n    try:\n        bad=m.load_ledger(path);observed={'accepted':True,'remaining':str(m.remaining_seconds(bad)),'request_budget':str(m.request_budget(bad))}\n    except m.LedgerCorrupt as e:observed={'accepted':False,'error':str(e)}\n    cases.append({'id':'nonfinite-ledger-corruption','expected':'LedgerCorrupt for NaN budget','observed':observed,'verdict':'FAIL' if observed['accepted'] else 'PASS'})\n    result={'schema_version':'root-w23-light-probe/1','no_model_or_network':True,'copy_only':['campaign.py','cache.py'],'runner':'explicit stub reached through unchanged actual X1F dispatch, fake-CLI branch unused','cases':cases}\n    (ROOT/'probe-results.json').write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf8');print(json.dumps(result,ensure_ascii=False,indent=2))\nif __name__=='__main__':worker() if len(sys.argv)>1 and sys.argv[1]=='worker' else main()\n",
