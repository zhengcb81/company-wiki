    "source": "from copy import deepcopy\nfrom hashlib import sha256\nfrom importlib.util import module_from_spec, spec_from_file_location\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nimport pytest\n\nfrom tools import source_case_runner as runner\nfrom tools.source_case_receipt import encode_source_receipt\n\n\ndef fast_tool():\n    path = Path('C:/Users/郑曾波/Projects/invest-skills/tools/pre_push_gate.py')\n    spec = spec_from_file_location('independent_root_fast', path)\n    module = module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef test_complete_unseen_record_retains_all_large_evidence_and_unknowns():\n    record = {'status': 'SOURCE_RETURNED', 'source_processing_complete': False,\n              'runtime_unchanged': None, 'required_units': [{'unit_id': 'u-x', 'represented': False}],\n              'source_excerpt_units': [{'unit_id': 'u-x', 'raw_text': '精确原文🙂' * 130000}],\n              'optional_trace': [{'exact': str(i) + 'x'*5000} for i in range(100)]}\n    before = deepcopy(record)\n    data = runner.encode_receipt(record)\n    assert len(data) > 1000000 and json.loads(data) == before == record\n    assert json.loads(encode_source_receipt(record)) == before\n\n\ndef test_unseen_deep_tree_and_cycle_are_not_confused():\n    sections = [{'section_id':str(i), 'parent_id':str(i+1) if i < 172 else None,\n                 'heading_unit_ids':['h'+str(i)],'body_unit_ids':['target'] if i==0 else []} for i in range(173)]\n    source = {'sections':sections}\n    oracles = [{'oracle_id':'independent','original_support_unit_ids':['target']}]\n    originals = {uid:object() for uid in ['target',*['h'+str(i) for i in range(173)]]}\n    rows,_=runner.structure_context_checkpoints(oracles,source,originals)\n    assert rows[0]['support_units'][0]['section_paths'][0]['ancestry_path_complete'] is True\n    assert len(rows[0]['support_units'][0]['ancestor_heading_unit_ids']) == 173\n    sections[-1]['parent_id']='7'\n    rows,_=runner.structure_context_checkpoints(oracles,source,originals)\n    assert rows[0]['support_units'][0]['section_paths'][0]['ancestry_path_complete'] is False\n\n\ndef test_context_proof_overlap_keeps_roles_without_forging_actor_pass():\n    structure = {'sections':[{'section_id':'a','parent_id':None,'heading_unit_ids':['heading'],'body_unit_ids':['target']}],\n        'semantic_units':[{'required_context_by_unit_id':{'target':['both','qualifier']},\n            'required_source_unit_ids_by_unit_id':{'target':['both','proof-only']}}],\n        'diagnostics':[{'code':'SOURCE_SCOPE_UNPROVEN','unit_ids':['target']} ]}\n    before=deepcopy(structure)\n    oracle=[{'oracle_id':'roles','original_support_unit_ids':['target'],\n             'original_forbidden_context_unit_ids':['proof-only','both','heading']}]\n    rows,ids=runner.structure_context_checkpoints(oracle,structure,{'target':object()})\n    row=rows[0]['support_units'][0]\n    assert row['forbidden_context_ids_observed']==['both','heading']\n    assert row['semantic_context_unit_ids']==['both','qualifier']\n    assert row['physical_source_proof_unit_ids']==['both','proof-only']\n    assert row['unavailable_context_unit_ids']==sorted(ids)\n    assert rows[0]['status']=='STRUCTURE_OBSERVED_NO_ACTOR_INFERENCE'\n    assert row['source_diagnostics'] and structure==before\n\n\ndef test_real_atomic_io_failure_keeps_previous_checkpoint(tmp_path,monkeypatch):\n    path=tmp_path/'current.json';owned={}\n    runner.atomic_owned_write(path,b'previous',owned,root_dir=tmp_path)\n    def unavailable(fd):raise OSError('synthetic fsync unavailable')\n    monkeypatch.setattr(runner.os,'fsync',unavailable)\n    with pytest.raises(OSError):runner.atomic_owned_write(path,b'new',owned,root_dir=tmp_path)\n    assert path.read_bytes()==b'previous' and owned[path.resolve()]==sha256(b'previous').hexdigest()\n    assert not list(tmp_path.glob('*.writing-*'))\n\n\ndef test_worker_encoding_failure_preserves_unknown_state_and_real_checkpoint(tmp_path,monkeypatch):\n    case=tmp_path/'cases.json';output=tmp_path/'result.json'\n    case.write_text(json.dumps({'cases':[{'case_id':'unique','request':{'source_ref':{'source_id':'synthetic'}}}]}),encoding='utf-8')\n    class Unknown:\n        def __repr__(self):raise AssertionError('no arbitrary repr')\n    record={'case_id':'unique','status':'SOURCE_RETURNED','required_units':[{'unit_id':'u','represented':False}],\n            'database_unchanged':None,'original_files_unchanged':False,'runtime_unchanged':True,'optional':Unknown()}\n    monkeypatch.setattr(runner,'execute',lambda *args,**kwargs:record)\n    monkeypatch.setattr(sys,'argv',['observer','--worker','--manifest',str(case),'--case','unique','--output',str(output)])\n    with pytest.raises(SystemExit) as caught:runner.main()\n    assert caught.value.code==2\n    saved=json.loads(output.read_bytes());checkpoint=json.loads(output.with_suffix('.json.checkpoint.json').read_bytes())\n    assert saved['status']=='OBSERVATION_INCOMPLETE' and saved['source_status']=='SOURCE_RETURNED'\n    assert checkpoint['database_unchanged'] is None and checkpoint['original_files_unchanged'] is False\n    assert checkpoint['required_checkpoints'][0]['represented'] is False\n\n\ndef test_commit_checks_staged_content_not_a_different_worktree_version(tmp_path,monkeypatch):\n    repo=tmp_path/'git';repo.mkdir()\n    subprocess.run(['git','init','-q',str(repo)],check=True,capture_output=True)\n    path=repo/'changed.py';path.write_text('def staged_invalid(:\\n',encoding='utf-8')\n    subprocess.run(['git','-C',str(repo),'add','changed.py'],check=True,capture_output=True)\n    path.write_text('valid_worktree = True\\n',encoding='utf-8')\n    staged=subprocess.run(['git','-C',str(repo),'show',':changed.py'],check=True,capture_output=True).stdout\n    assert staged==b'def staged_invalid(:\\n'\n    tool=fast_tool();monkeypatch.setattr(tool,'PROJECT_ROOT',repo)\n    calls=[]\n    monkeypatch.setattr(tool,'_run',lambda *args,**kwargs:calls.append(args) or 0)\n    code=tool.main(['--commit'])\n    assert code!=0, 'Invalid index bytes must not be certified from a valid worktree version'\n\n\n@pytest.mark.parametrize('exit_code',[0,23])\ndef test_actual_fast_runner_does_not_veto_large_logs_or_hide_real_exit(exit_code,capsys):\n    tool=fast_tool()\n    command=[sys.executable,'-B','-c',\"import sys;sys.stdout.write('x'*80000+'final-marker');sys.exit(\"+str(exit_code)+\")\"]\n    assert tool._run(command,'independent noisy child')==exit_code\n    printed=capsys.readouterr().out\n    assert 'final-marker' in printed and len(printed)<17000\n"
