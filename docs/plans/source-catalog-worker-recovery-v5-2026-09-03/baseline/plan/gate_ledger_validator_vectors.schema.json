{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:validator-vectors-instance:v4",
  "title":"Ledger validator declarative vector instance schema",
  "type":"object",
  "additionalProperties":false,
  "$comment":"base_fixture is the retained wire name for a composite scenario_id. T00L resolves it through validator_fixture_manifest.v2.json, materializes each negative case as one mutation_case, proves the unmutated scenario returns OK, then requires the exact rule/code/stage/pointer. Inline mutation objects are blueprints, never executed against an unvalidated ad-hoc document.",
  "$defs":{
    "jsonPointer":{"type":"string","pattern":"^(?:|/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*)$"},
    "fixtureId":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
    "nodeId":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "pointerReplace":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","value"],
      "properties":{"op":{"const":"JSON_POINTER_REPLACE"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"value":true}
    },
    "pointerRemove":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer"],
      "properties":{"op":{"const":"JSON_POINTER_REMOVE"},"target_pointer":{"$ref":"#/$defs/jsonPointer"}}
    },
    "pointerAdd":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","value"],
      "properties":{"op":{"const":"JSON_POINTER_ADD"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"value":true}
    },
    "pointerCopy":{
      "type":"object","additionalProperties":false,
      "required":["op","source_pointer","target_pointer"],
      "properties":{"op":{"const":"JSON_POINTER_COPY"},"source_pointer":{"$ref":"#/$defs/jsonPointer"},"target_pointer":{"$ref":"#/$defs/jsonPointer"}}
    },
    "fixturePointerCopy":{
      "type":"object","additionalProperties":false,
      "required":["op","source_fixture_id","source_pointer","target_pointer"],
      "properties":{"op":{"const":"FIXTURE_POINTER_COPY"},"source_fixture_id":{"$ref":"#/$defs/fixtureId"},"source_pointer":{"$ref":"#/$defs/jsonPointer"},"target_pointer":{"$ref":"#/$defs/jsonPointer"}}
    },
    "appendFixture":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","fixture_id"],
      "properties":{"op":{"const":"APPEND_FIXTURE"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"fixture_id":{"$ref":"#/$defs/fixtureId"}}
    },
    "insertFixture":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","fixture_id"],
      "properties":{"op":{"const":"INSERT_FIXTURE"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"fixture_id":{"$ref":"#/$defs/fixtureId"}}
    },
    "documentReplace":{
      "type":"object","additionalProperties":false,
      "required":["op","value"],
      "properties":{"op":{"const":"JSON_DOCUMENT_REPLACE"},"value":true}
    },
    "integerOffset":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","offset"],
      "properties":{"op":{"const":"INTEGER_OFFSET"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"offset":{"type":"integer","not":{"const":0}}}
    },
    "hashCorrupt":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","algorithm"],
      "properties":{"op":{"const":"HASH_CORRUPT"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"algorithm":{"const":"FLIP_LOWEST_ORDER_BIT"}}
    },
    "reuseReviewerSet":{
      "type":"object","additionalProperties":false,
      "required":["op","source_node_id","target_node_id"],
      "properties":{"op":{"const":"REUSE_REVIEWER_SET"},"source_node_id":{"$ref":"#/$defs/nodeId"},"target_node_id":{"$ref":"#/$defs/nodeId"}}
    },
    "duplicateArrayItem":{
      "type":"object","additionalProperties":false,
      "required":["op","target_pointer","source_index"],
      "properties":{"op":{"const":"DUPLICATE_ARRAY_ITEM"},"target_pointer":{"$ref":"#/$defs/jsonPointer"},"source_index":{"type":"integer","minimum":0}}
    },
    "rawDuplicateKey":{
      "type":"object","additionalProperties":false,
      "required":["op","object_pointer","key"],
      "properties":{"op":{"const":"RAW_JSON_DUPLICATE_OBJECT_KEY"},"object_pointer":{"$ref":"#/$defs/jsonPointer"},"key":{"type":"string","minLength":1,"maxLength":100}}
    },
    "mutation":{
      "oneOf":[
        {"$ref":"#/$defs/pointerReplace"},{"$ref":"#/$defs/pointerRemove"},{"$ref":"#/$defs/pointerAdd"},
        {"$ref":"#/$defs/pointerCopy"},{"$ref":"#/$defs/fixturePointerCopy"},{"$ref":"#/$defs/appendFixture"},
        {"$ref":"#/$defs/insertFixture"},{"$ref":"#/$defs/documentReplace"},{"$ref":"#/$defs/integerOffset"},
        {"$ref":"#/$defs/hashCorrupt"},{"$ref":"#/$defs/reuseReviewerSet"},{"$ref":"#/$defs/duplicateArrayItem"},{"$ref":"#/$defs/rawDuplicateKey"}
      ]
    },
    "case":{
      "type":"object","additionalProperties":false,
      "required":["case_id","base_fixture","mutation","expected_exit","expected_primary_code","reason_rule_id","validation_stage","expected_pointer"],
      "properties":{
        "case_id":{"type":"string","pattern":"^GL-[SF][0-9]{2}-[A-Z0-9]+$"},
        "base_fixture":{"$ref":"#/$defs/fixtureId"},
        "mutation":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/mutation"}]},
        "expected_exit":{"enum":[0,1]},
        "expected_primary_code":{"pattern":"^(OK|GLV-E[0-9]{3})$"},
        "reason_rule_id":{"type":"string","pattern":"^(?:OK|[A-Z][A-Z0-9_]{2,79})$"},
        "validation_stage":{"enum":["ACCEPT","FIXTURE_EXPANSION","DOCUMENT_SHAPE","SCHEMA","HASH_DEPENDENCY","HASH_CHAIN","DAG","REVIEW_POLICY","ARTIFACT_INTEGRITY","BOOTSTRAP_POLICY","OPERATION_POLICY","AUTHORIZATION_POLICY","JOURNAL_POLICY","BUDGET_POLICY","STATE_MACHINE","COMPENSATION_POLICY","TEST_REGISTRY_POLICY"]},
        "expected_pointer":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/jsonPointer"}]}
      }
    },
    "vector":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","cases"],
      "properties":{
        "id":{"type":"string","pattern":"^GL-[SF][0-9]{2}$"},
        "kind":{"enum":["positive","negative"]},
        "cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case"}}
      },
      "allOf":[
        {
          "if":{"properties":{"kind":{"const":"positive"}},"required":["kind"]},
          "then":{"properties":{"cases":{"items":{"properties":{"mutation":{"type":"null"},"expected_exit":{"const":0},"expected_primary_code":{"const":"OK"},"reason_rule_id":{"const":"OK"},"validation_stage":{"const":"ACCEPT"},"expected_pointer":{"type":"null"}}}}}},
          "else":{"properties":{"cases":{"items":{"properties":{"mutation":{"$ref":"#/$defs/mutation"},"expected_exit":{"const":1},"expected_primary_code":{"pattern":"^GLV-E[0-9]{3}$"},"expected_pointer":{"$ref":"#/$defs/jsonPointer"}}}}}}
        }
      ]
    },
    "reasonMapping":{
      "type":"object","additionalProperties":false,
      "required":["primary_code","validation_stage","pointer_prefix"],
      "properties":{"primary_code":{"pattern":"^(OK|GLV-E[0-9]{3})$"},"validation_stage":{"enum":["ACCEPT","FIXTURE_EXPANSION","DOCUMENT_SHAPE","SCHEMA","HASH_DEPENDENCY","HASH_CHAIN","DAG","REVIEW_POLICY","ARTIFACT_INTEGRITY","BOOTSTRAP_POLICY","OPERATION_POLICY","AUTHORIZATION_POLICY","JOURNAL_POLICY","BUDGET_POLICY","STATE_MACHINE","COMPENSATION_POLICY","TEST_REGISTRY_POLICY"]},"pointer_prefix":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/jsonPointer"}]}}
    }
  },
  "required":["schema_id","contract","plan_revision","note","fixture_contract","reason_rule_mappings","vectors","global_vector_requirements"],
  "properties":{
    "schema_id":{"const":"urn:company-wiki:source-catalog-worker-recovery:validator-vectors-instance:v4"},
    "contract":{"const":"gate-ledger-validator-v4-test-vectors"},
    "plan_revision":{"const":"v4"},
    "note":{"type":"string","minLength":20},
    "fixture_contract":{
      "type":"object","additionalProperties":false,
      "required":["manifest_schema_path","manifest_instance_path","scenario_schema_path","generated_at_node","frozen_at_node","base_fixture_field_semantics","case_to_mutation_id_policy","base_fixture_must_return_ok_before_mutation","all_scenario_members_schema_valid","materialized_mutation_required","pointer_and_type_checked_before_execution","derived_recompute_closure_required","case_ids_unique","fixture_manifest_ids_unique","mutation_must_trigger_exactly_one_declared_primary_rule","unknown_fixture_policy"],
      "properties":{
        "manifest_schema_path":{"const":"validator_fixture_manifest.schema.json"},
        "manifest_instance_path":{"const":"validator_fixture_manifest.v2.json"},
        "scenario_schema_path":{"const":"validator_scenario_fixture.schema.json"},
        "generated_at_node":{"const":"T00L"},
        "frozen_at_node":{"const":"D00L"},
        "base_fixture_field_semantics":{"const":"COMPOSITE_SCENARIO_ID_LEGACY_WIRE_NAME"},
        "case_to_mutation_id_policy":{"const":"MUTATION_ID_EQUALS_CASE_ID"},
        "base_fixture_must_return_ok_before_mutation":{"const":true},
        "all_scenario_members_schema_valid":{"const":true},
        "materialized_mutation_required":{"const":true},
        "pointer_and_type_checked_before_execution":{"const":true},
        "derived_recompute_closure_required":{"const":true},
        "case_ids_unique":{"const":true},
        "fixture_manifest_ids_unique":{"const":true},
        "mutation_must_trigger_exactly_one_declared_primary_rule":{"const":true},
        "unknown_fixture_policy":{"const":"REJECT_BEFORE_VALIDATOR_EXECUTION"}
      }
    },
    "reason_rule_mappings":{"type":"object","minProperties":20,"additionalProperties":{"$ref":"#/$defs/reasonMapping"}},
    "vectors":{"type":"array","minItems":18,"maxItems":18,"items":{"$ref":"#/$defs/vector"}},
    "global_vector_requirements":{
      "type":"object","additionalProperties":false,
      "required":["each_case_has_one_primary_reason_code","reason_rule_mapping_must_match_case","secondary_codes_may_be_reported_but_must_not_replace_primary","all_paths_are_tmp","network_calls","production_registry_calls","production_database_opens","property_sequences_minimum","mutation_survivors_allowed","shape_negative_cases","vector_ids_exact"],
      "properties":{
        "each_case_has_one_primary_reason_code":{"const":true},
        "reason_rule_mapping_must_match_case":{"const":true},
        "secondary_codes_may_be_reported_but_must_not_replace_primary":{"const":true},
        "all_paths_are_tmp":{"const":true},
        "network_calls":{"const":0},
        "production_registry_calls":{"const":0},
        "production_database_opens":{"const":0},
        "property_sequences_minimum":{"type":"integer","minimum":200},
        "mutation_survivors_allowed":{"const":0},
        "shape_negative_cases":{"const":["EMPTY_OBJECT","EMPTY_ARRAY","SCALAR_STRING"]},
        "vector_ids_exact":{"const":["GL-S01","GL-S02","GL-S03","GL-S04","GL-S05","GL-S06","GL-F01","GL-F02","GL-F03","GL-F04","GL-F05","GL-F06","GL-F07","GL-F08","GL-F09","GL-F10","GL-F11","GL-F12"]}
      }
    }
  }
}
