{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:validator-request:v1",
  "title": "Canonical ledger-validator invocation request",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"}
  },
  "required": ["schema_version", "request_id", "ledger_transcript_path", "ledger_transcript_sha256", "gate_dag_path", "gate_dag_sha256", "schema_registry_path", "schema_registry_sha256", "head_anchor_path", "head_anchor_sha256", "clock_utc", "authored_next_eligible_nodes", "request_sha256", "sealed"],
  "properties": {
    "schema_version": {"const": "validator-request-v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "ledger_transcript_path": {"type": "string", "pattern": "^scenario/[A-Za-z0-9][A-Za-z0-9._/-]*/gate_ledger_transcript\\.json$"},
    "ledger_transcript_sha256": {"$ref": "#/$defs/sha256"},
    "gate_dag_path": {"const": "scenario/gate_dag.v4.json"},
    "gate_dag_sha256": {"$ref": "#/$defs/sha256"},
    "schema_registry_path": {"const": "scenario/schema_registry.v1.json"},
    "schema_registry_sha256": {"$ref": "#/$defs/sha256"},
    "head_anchor_path": {"type": "string", "pattern": "^scenario/[A-Za-z0-9][A-Za-z0-9._/-]*/ledger_head_anchor\\.json$"},
    "head_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "clock_utc": {"$ref": "#/$defs/utc"},
    "authored_next_eligible_nodes": {"anyOf": [{"type": "null"}, {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"}}]},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "sealed": {"const": true}
  },
  "x-semantic-rules": [
    "authored_next_eligible_nodes must be null for an accepted request. The validator computes eligibility from the frozen DAG and validated transcript; any authored non-null value returns GLV-E018 at /authored_next_eligible_nodes before execution.",
    "All paths resolve beneath one new empty fixture root without reparse traversal. Hashes bind exact stored bytes and request_sha256 is RFC 8785 JCS SHA-256 excluding request_sha256.",
    "This request descriptor is data only. It grants no path, registry, process, database or network authority and is safe to materialize solely under the hermetic fixture root."
  ]
}
