{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:authorization-manifest:v4",
  "title": "Intent-bound production authorization manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "opNodeId": {
      "type": "string",
      "pattern": "^(OP00|OP11A|OP11M|OP11J|OP11M-L|OP11B-A[123]|OP11B-BP|OP11B-BF(?:0[1-9]|[1-9][0-9])|OP12A|OP12B-ARM|OP12B-CAS|OP12B-LOGIN|OP12B-RB|OP12C|OP12C-RB|OP05R(?:0[1-9]|[1-9][0-9])|OP-RUNTIME-CYCLE)$"
    },
    "productionState": {
      "enum": ["PAUSED/OFF", "PAUSED/ON", "PAUSED/REGISTRY_CONFLICT", "ARMED_PRELOGIN/OFF", "ARMED_ON_PRELOGIN/ON", "LOGIN_COMMITTED/ON", "RUNNING_LOGIN_VALIDATION/ON", "LOGIN_VALIDATED_PAUSED/ON", "ENABLED_IDLE/ON"]
    },
    "candidateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_kind", "document_id", "source_id", "source_sha256", "opaque_root_id"],
      "properties": {
        "candidate_kind": {"enum": ["DOCUMENT", "ROOT_ONLY"]},
        "document_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 160}]},
        "source_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 160}]},
        "source_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "opaque_root_id": {"type": "string", "minLength": 1, "maxLength": 160}
      },
      "allOf": [
        {
          "if": {"properties": {"candidate_kind": {"const": "DOCUMENT"}}, "required": ["candidate_kind"]},
          "then": {"properties": {"document_id": {"type": "string"}, "source_id": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"candidate_kind": {"const": "ROOT_ONLY"}}, "required": ["candidate_kind"]},
          "then": {"properties": {"document_id": {"type": "null"}, "source_id": {"type": "null"}, "source_sha256": {"type": "null"}}}
        }
      ]
    },
    "authorizedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "operation_node_id", "stage_node_id", "action_class", "effect_binding_mode", "effect_digest_sha256", "operation_intent_action_sha256",
        "operation_contract_template_sha256", "process_generation_binding_mode", "process_generation", "process_generation_policy_sha256", "control_generation", "circuit_generation",
        "registry_value_sha256", "registry_value_byte_length"
      ],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "operation_node_id": {"$ref": "#/$defs/opNodeId"},
        "stage_node_id": {"type": "string", "pattern": "^(D|OP|G)[A-Za-z0-9-]{1,31}$"},
        "action_class": {
          "enum": [
            "READ_ONLY", "DB_WRITE", "FILE_WRITE", "NETWORK_EGRESS", "STARTUP_ARM",
            "REGISTRY_CREATE_IF_ABSENT", "LOGIN_LOGOFF", "FINAL_ACTIVATION",
            "ROLLBACK", "CIRCUIT_RESET", "CYCLE_EXECUTION"
          ]
        },
        "effect_binding_mode": {"enum": ["EXACT_EFFECT", "TEMPLATE_MAXIMA"]},
        "effect_digest_sha256": {"$ref": "#/$defs/sha256"},
        "operation_intent_action_sha256": {"$ref": "#/$defs/sha256"},
        "operation_contract_template_sha256": {"$ref": "#/$defs/sha256"},
        "process_generation_binding_mode": {"enum": ["EXACT", "MONOTONIC_CURRENT_PROTECTED_STATE"]},
        "process_generation": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "process_generation_policy_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "control_generation": {"type": "integer", "minimum": 0},
        "circuit_generation": {"type": "integer", "minimum": 0},
        "registry_value_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "registry_value_byte_length": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 2, "maximum": 65534, "multipleOf": 2}]}
      },
      "allOf": [
        {
          "if": {"properties": {"action_class": {"const": "REGISTRY_CREATE_IF_ABSENT"}}, "required": ["action_class"]},
          "then": {"properties": {"operation_node_id": {"const": "OP12B-CAS"}, "registry_value_sha256": {"$ref": "#/$defs/sha256"}, "registry_value_byte_length": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"action_class": {"not": {"const": "REGISTRY_CREATE_IF_ABSENT"}}}, "required": ["action_class"]},
          "then": {"properties": {"registry_value_sha256": {"type": "null"}, "registry_value_byte_length": {"type": "null"}}}
        },
        {
          "if": {"properties": {"action_class": {"const": "CIRCUIT_RESET"}}, "required": ["action_class"]},
          "then": {"properties": {"operation_node_id": {"pattern": "^OP05R(?:0[1-9]|[1-9][0-9])$"}}}
        },
        {
          "if": {"properties": {"action_class": {"const": "ROLLBACK"}}, "required": ["action_class"]},
          "then": {"properties": {"operation_node_id": {"enum": ["OP12B-RB", "OP12C-RB"]}}}
        },
        {
          "if": {"properties": {"action_class": {"const": "CYCLE_EXECUTION"}}, "required": ["action_class"]},
          "then": {"properties": {"action_id": {"const": "ORDINARY_AUTOSTART_CYCLE"}, "operation_node_id": {"const": "OP-RUNTIME-CYCLE"}, "stage_node_id": {"const": "OP-RUNTIME-CYCLE"}, "effect_binding_mode": {"const": "TEMPLATE_MAXIMA"}, "process_generation_binding_mode": {"const": "MONOTONIC_CURRENT_PROTECTED_STATE"}, "process_generation": {"type": "null"}, "process_generation_policy_sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"action_class": {"not": {"const": "CYCLE_EXECUTION"}}}, "required": ["action_class"]},
          "then": {"properties": {"effect_binding_mode": {"const": "EXACT_EFFECT"}, "process_generation_binding_mode": {"const": "EXACT"}, "process_generation": {"type": "integer"}, "process_generation_policy_sha256": {"type": "null"}}}
        }
      ]
    },
    "compensationAuthorizedAction": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "operation_node_id", "stage_node_id", "action_class", "effect_binding_mode", "effect_digest_sha256", "action_projection_sha256", "operation_contract_template_sha256", "process_generation_binding_mode", "process_generation_policy_sha256", "control_generation", "circuit_generation", "registry_value_sha256", "registry_value_byte_length"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "operation_node_id": {"enum": ["OP12B-RB", "OP12C-RB"]},
        "stage_node_id": {"enum": ["D12B-RB", "D12C"]},
        "action_class": {"const": "ROLLBACK"},
        "effect_binding_mode": {"const": "EXACT_EFFECT"},
        "effect_digest_sha256": {"$ref": "#/$defs/sha256"},
        "action_projection_sha256": {"$ref": "#/$defs/sha256"},
        "operation_contract_template_sha256": {"$ref": "#/$defs/sha256"},
        "process_generation_binding_mode": {"const": "TRIGGER_EVIDENCE_CURRENT_PROTECTED_STATE"},
        "process_generation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "control_generation": {"type": "integer", "minimum": 0},
        "circuit_generation": {"type": "integer", "minimum": 0},
        "registry_value_sha256": {"type": "null"},
        "registry_value_byte_length": {"type": "null"}
      }
    },
    "compensationBranchGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "authorized_trigger_node_ids", "allowed_source_states", "terminal_state", "forward_effect_status", "expected_generation_delta", "registry_observation", "required_registry_operation", "control_effect", "max_file_writes", "expected_registry_values_touched"],
      "properties": {
        "branch": {"enum": ["12B_PRE_EFFECT_NOOP", "12B_PRE_CAS_ABSENT", "12B_POST_CAS_OWNED_PRESERVE_SAFE_PAUSED", "12B_POST_CAS_ABSENT_SAFE_OFF", "12B_THIRD_PARTY_CONFLICT_PRESERVE", "12C_PRE_CONTROL_WRITE_NOOP", "12C_POST_CONTROL_WRITE_ROLLBACK", "12C_REGISTRY_ABSENT_SAFE_OFF", "12C_THIRD_PARTY_CONFLICT_PRESERVE"]},
        "authorized_trigger_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["OP12B-ARM", "G12B-ARM", "D12B-CAS", "OP12B-CAS", "G12B-CAS", "D12B-LOGIN", "OP12B-LOGIN", "G12B-POST", "G12C-PRE", "OP12C", "G12C"]}},
        "allowed_source_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/productionState"}},
        "terminal_state": {"$ref": "#/$defs/productionState"},
        "forward_effect_status": {"enum": ["NO_FORWARD_EFFECT_DURABLE", "ARM_TOKEN_ONLY", "REGISTRY_EXACT_OWNED", "CONTROL_STATE_ACTIVATED", "REGISTRY_ABSENT_AFTER_FORWARD_EFFECT", "THIRD_PARTY_OR_DRIFT_OBSERVED"]},
        "expected_generation_delta": {"type": "integer", "minimum": 0, "maximum": 1},
        "registry_observation": {"enum": ["ABSENT", "EXACT_OWNED", "THIRD_PARTY_OR_DRIFT"]},
        "required_registry_operation": {"enum": ["VERIFY_ABSENT", "VERIFY_EXACT", "VERIFY_OWNED_PRESERVE", "VERIFY_CONFLICT_PRESERVE"]},
        "control_effect": {"enum": ["NO_CHANGE", "INVALIDATE_PRELOGIN_TOKENS", "ROLLBACK_EXACT_CONTROL_STATE", "SET_PAUSED_OFF", "SET_CONFLICT_PAUSE"]},
        "max_file_writes": {"type": "integer", "minimum": 0, "maximum": 8},
        "expected_registry_values_touched": {"type": "integer", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"branch": {"const": "12B_PRE_EFFECT_NOOP"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"const": "OP12B-ARM"}}, "allowed_source_states": {"const": ["PAUSED/OFF"]}, "terminal_state": {"const": "PAUSED/OFF"}, "forward_effect_status": {"const": "NO_FORWARD_EFFECT_DURABLE"}, "expected_generation_delta": {"const": 0}, "registry_observation": {"const": "ABSENT"}, "required_registry_operation": {"const": "VERIFY_ABSENT"}, "control_effect": {"const": "NO_CHANGE"}, "max_file_writes": {"const": 0}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12B_PRE_CAS_ABSENT"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["G12B-ARM", "D12B-CAS", "OP12B-CAS"]}}, "allowed_source_states": {"const": ["ARMED_PRELOGIN/OFF"]}, "terminal_state": {"const": "PAUSED/OFF"}, "forward_effect_status": {"const": "ARM_TOKEN_ONLY"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "ABSENT"}, "required_registry_operation": {"const": "VERIFY_ABSENT"}, "control_effect": {"const": "INVALIDATE_PRELOGIN_TOKENS"}, "max_file_writes": {"minimum": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12B_POST_CAS_OWNED_PRESERVE_SAFE_PAUSED"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["OP12B-CAS", "G12B-CAS", "D12B-LOGIN", "OP12B-LOGIN", "G12B-POST"]}}, "allowed_source_states": {"items": {"enum": ["ARMED_ON_PRELOGIN/ON", "LOGIN_COMMITTED/ON", "RUNNING_LOGIN_VALIDATION/ON", "LOGIN_VALIDATED_PAUSED/ON"]}}, "terminal_state": {"const": "PAUSED/ON"}, "forward_effect_status": {"const": "REGISTRY_EXACT_OWNED"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "EXACT_OWNED"}, "required_registry_operation": {"const": "VERIFY_OWNED_PRESERVE"}, "control_effect": {"const": "INVALIDATE_PRELOGIN_TOKENS"}, "max_file_writes": {"minimum": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12B_POST_CAS_ABSENT_SAFE_OFF"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["OP12B-CAS", "G12B-CAS", "D12B-LOGIN", "OP12B-LOGIN", "G12B-POST"]}}, "allowed_source_states": {"items": {"enum": ["ARMED_ON_PRELOGIN/ON", "LOGIN_COMMITTED/ON", "RUNNING_LOGIN_VALIDATION/ON", "LOGIN_VALIDATED_PAUSED/ON"]}}, "terminal_state": {"const": "PAUSED/OFF"}, "forward_effect_status": {"const": "REGISTRY_ABSENT_AFTER_FORWARD_EFFECT"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "ABSENT"}, "required_registry_operation": {"const": "VERIFY_ABSENT"}, "control_effect": {"const": "INVALIDATE_PRELOGIN_TOKENS"}, "max_file_writes": {"minimum": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12B_THIRD_PARTY_CONFLICT_PRESERVE"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["OP12B-CAS", "G12B-CAS", "D12B-LOGIN", "OP12B-LOGIN", "G12B-POST"]}}, "allowed_source_states": {"items": {"enum": ["ARMED_PRELOGIN/OFF", "ARMED_ON_PRELOGIN/ON", "LOGIN_COMMITTED/ON", "RUNNING_LOGIN_VALIDATION/ON", "LOGIN_VALIDATED_PAUSED/ON"]}}, "terminal_state": {"const": "PAUSED/REGISTRY_CONFLICT"}, "forward_effect_status": {"const": "THIRD_PARTY_OR_DRIFT_OBSERVED"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "THIRD_PARTY_OR_DRIFT"}, "required_registry_operation": {"const": "VERIFY_CONFLICT_PRESERVE"}, "control_effect": {"const": "SET_CONFLICT_PAUSE"}, "max_file_writes": {"minimum": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12C_PRE_CONTROL_WRITE_NOOP"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["G12C-PRE", "OP12C"]}}, "allowed_source_states": {"const": ["LOGIN_VALIDATED_PAUSED/ON"]}, "terminal_state": {"const": "LOGIN_VALIDATED_PAUSED/ON"}, "forward_effect_status": {"const": "NO_FORWARD_EFFECT_DURABLE"}, "expected_generation_delta": {"const": 0}, "registry_observation": {"const": "EXACT_OWNED"}, "required_registry_operation": {"const": "VERIFY_EXACT"}, "control_effect": {"const": "NO_CHANGE"}, "max_file_writes": {"const": 0}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12C_POST_CONTROL_WRITE_ROLLBACK"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["OP12C", "G12C"]}}, "allowed_source_states": {"const": ["ENABLED_IDLE/ON"]}, "terminal_state": {"const": "LOGIN_VALIDATED_PAUSED/ON"}, "forward_effect_status": {"const": "CONTROL_STATE_ACTIVATED"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "EXACT_OWNED"}, "required_registry_operation": {"const": "VERIFY_EXACT"}, "control_effect": {"const": "ROLLBACK_EXACT_CONTROL_STATE"}, "max_file_writes": {"const": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12C_REGISTRY_ABSENT_SAFE_OFF"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["G12C-PRE", "OP12C", "G12C"]}}, "allowed_source_states": {"items": {"enum": ["LOGIN_VALIDATED_PAUSED/ON", "ENABLED_IDLE/ON"]}}, "terminal_state": {"const": "PAUSED/OFF"}, "forward_effect_status": {"const": "REGISTRY_ABSENT_AFTER_FORWARD_EFFECT"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "ABSENT"}, "required_registry_operation": {"const": "VERIFY_ABSENT"}, "control_effect": {"const": "SET_PAUSED_OFF"}, "max_file_writes": {"const": 1}, "expected_registry_values_touched": {"const": 0}}}},
        {"if": {"properties": {"branch": {"const": "12C_THIRD_PARTY_CONFLICT_PRESERVE"}}, "required": ["branch"]}, "then": {"properties": {"authorized_trigger_node_ids": {"items": {"enum": ["OP12C", "G12C"]}}, "allowed_source_states": {"items": {"enum": ["LOGIN_VALIDATED_PAUSED/ON", "ENABLED_IDLE/ON"]}}, "terminal_state": {"const": "PAUSED/REGISTRY_CONFLICT"}, "forward_effect_status": {"const": "THIRD_PARTY_OR_DRIFT_OBSERVED"}, "expected_generation_delta": {"const": 1}, "registry_observation": {"const": "THIRD_PARTY_OR_DRIFT"}, "required_registry_operation": {"const": "VERIFY_CONFLICT_PRESERVE"}, "control_effect": {"const": "SET_CONFLICT_PAUSE"}, "max_file_writes": {"const": 1}, "expected_registry_values_touched": {"const": 0}}}}
      ]
    },
    "compensationGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "grant_sha256", "action", "branch_contract", "issued_at", "valid_until", "child_authorization_kind"],
      "properties": {
        "grant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "grant_sha256": {"$ref": "#/$defs/sha256"},
        "action": {"$ref": "#/$defs/compensationAuthorizedAction"},
        "branch_contract": {"$ref": "#/$defs/compensationBranchGrant"},
        "issued_at": {"$ref": "#/$defs/utcTimestamp"},
        "valid_until": {"$ref": "#/$defs/utcTimestamp"},
        "child_authorization_kind": {"const": "BOUND_COMPENSATION"}
      },
      "allOf": [
        {"if": {"properties": {"action": {"properties": {"operation_node_id": {"const": "OP12B-RB"}}, "required": ["operation_node_id"]}}, "required": ["action"]}, "then": {"properties": {"branch_contract": {"properties": {"branch": {"pattern": "^12B_"}}}}}},
        {"if": {"properties": {"action": {"properties": {"operation_node_id": {"const": "OP12C-RB"}}, "required": ["operation_node_id"]}}, "required": ["action"]}, "then": {"properties": {"branch_contract": {"properties": {"branch": {"pattern": "^12C_"}}}}}}
      ]
    },
    "runtimeAuthorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_policy_id", "runtime_policy_sha256", "cycle_contract_schema_sha256",
        "intent_specialization_validator_sha256", "process_generation_policy_sha256", "process_generation_state_id", "process_generation_minimum", "process_generation_anchor_sha256_at_issue", "budget_policy_sha256", "durable_budget_ids",
        "per_cycle_maxima", "budget_currency", "budget_accounting_scope", "fresh_cycle_intent_required", "strict_specialization_required",
        "revocation_check_every_cycle", "authorization_refresh_triggers"
      ],
      "properties": {
        "operation_policy_id": {"const": "OP-RUNTIME-CYCLE"},
        "runtime_policy_sha256": {"$ref": "#/$defs/sha256"},
        "cycle_contract_schema_sha256": {"$ref": "#/$defs/sha256"},
        "intent_specialization_validator_sha256": {"$ref": "#/$defs/sha256"},
        "process_generation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "process_generation_state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "process_generation_minimum": {"type": "integer", "minimum": 0},
        "process_generation_anchor_sha256_at_issue": {"$ref": "#/$defs/sha256"},
        "budget_policy_sha256": {"$ref": "#/$defs/sha256"},
        "durable_budget_ids": {
          "type": "object", "additionalProperties": false,
          "required": ["daily_provider_requests", "daily_provider_cost", "monthly_provider_requests", "monthly_provider_cost"],
          "properties": {
            "daily_provider_requests": {"type": "string", "minLength": 8, "maxLength": 160},
            "daily_provider_cost": {"type": "string", "minLength": 8, "maxLength": 160},
            "monthly_provider_requests": {"type": "string", "minLength": 8, "maxLength": 160},
            "monthly_provider_cost": {"type": "string", "minLength": 8, "maxLength": 160}
          }
        },
        "per_cycle_maxima": {
          "type": "object", "additionalProperties": false,
          "required": ["max_documents", "max_characters", "max_input_tokens", "max_output_tokens", "max_cost_minor_units", "max_provider_requests", "max_retries"],
          "properties": {
            "max_documents": {"type": "integer", "minimum": 0},
            "max_characters": {"type": "integer", "minimum": 0},
            "max_input_tokens": {"type": "integer", "minimum": 0},
            "max_output_tokens": {"type": "integer", "minimum": 0},
            "max_cost_minor_units": {"type": "integer", "minimum": 0},
            "max_provider_requests": {"type": "integer", "minimum": 0},
            "max_retries": {"type": "integer", "minimum": 0}
          }
        },
        "budget_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "budget_accounting_scope": {"const": "GLOBAL_AGGREGATE_ACROSS_ALL_AUTHORIZED_PROVIDERS"},
        "fresh_cycle_intent_required": {"const": true},
        "strict_specialization_required": {"const": true},
        "revocation_check_every_cycle": {"const": true},
        "authorization_refresh_triggers": {"const": ["RELEASE_HASH_DRIFT", "CONFIG_HASH_DRIFT", "ROUTING_HASH_DRIFT", "DATA_ROOT_HASH_DRIFT", "CONTROL_GENERATION_DRIFT", "CIRCUIT_GENERATION_DRIFT", "TEMPLATE_HASH_DRIFT", "AUTHORIZATION_EXPIRY_OR_REVOCATION"]}
      }
    },
    "approvalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "subject_digest_sha256", "receipt_schema_sha256", "receipt_required_before_effect", "receipt_must_bind_this_authorization_hash", "distinct_from_approval_ids"],
      "properties": {
        "purpose": {"enum": ["SYSTEM_READ_ONLY_POLICY", "GENERAL_EXPLICIT_OPERATION", "RUNTIME_TEMPLATE_AUTHORIZATION", "FINAL_AUTOSTART_ACTIVATION", "PARENT_PREAUTHORIZED_COMPENSATION"]},
        "subject_digest_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_schema_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "receipt_required_before_effect": {"type": "boolean"},
        "receipt_must_bind_this_authorization_hash": {"type": "boolean"},
        "distinct_from_approval_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"}}
      },
      "allOf": [
        {"if": {"properties": {"purpose": {"enum": ["RUNTIME_TEMPLATE_AUTHORIZATION", "FINAL_AUTOSTART_ACTIVATION", "GENERAL_EXPLICIT_OPERATION"]}}, "required": ["purpose"]}, "then": {"properties": {"receipt_schema_sha256": {"$ref": "#/$defs/sha256"}, "receipt_required_before_effect": {"const": true}, "receipt_must_bind_this_authorization_hash": {"const": true}}}},
        {"if": {"properties": {"purpose": {"enum": ["SYSTEM_READ_ONLY_POLICY", "PARENT_PREAUTHORIZED_COMPENSATION"]}}, "required": ["purpose"]}, "then": {"properties": {"receipt_schema_sha256": {"type": "null"}, "receipt_required_before_effect": {"const": false}, "receipt_must_bind_this_authorization_hash": {"const": false}, "distinct_from_approval_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"purpose": {"const": "RUNTIME_TEMPLATE_AUTHORIZATION"}}, "required": ["purpose"]}, "then": {"properties": {"distinct_from_approval_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"purpose": {"const": "FINAL_AUTOSTART_ACTIVATION"}}, "required": ["purpose"]}, "then": {"properties": {"distinct_from_approval_ids": {"minItems": 1, "maxItems": 1}}}}
      ]
    }
  },
