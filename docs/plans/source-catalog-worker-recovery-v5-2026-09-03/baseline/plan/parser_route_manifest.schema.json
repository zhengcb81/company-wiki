{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:parser-route-manifest:v4",
  "title":"Frozen parser route and exact expanded test profile",
  "type":"object",
  "additionalProperties":false,
  "$comment":"The schema fixes the 14 route keys and all numeric floors. The G06P semantic validator MUST recompute expanded_test_ids with expansion_contract.algorithm_id and require byte-for-byte set equality; JSON Schema alone cannot derive that set.",
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "extensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^\\.[a-z0-9]+$"}},
    "supportedRoute":{
      "type":"object",
      "additionalProperties":false,
      "required":["route_code","route_status","extensions","enabled_small","medium_policy","oversize_policy","corrupt_applicable","encrypted_applicable","minimum_samples_small","minimum_samples_medium_or_disabled","minimum_samples_oversize","minimum_samples_error","minimum_pause_sequences"],
      "properties":{
        "route_code":{"enum":["01","02","03H","03T","04P","04D","05","06","07","08","09","10J","10X"]},
        "route_status":{"const":"SUPPORTED"},
        "extensions":{"$ref":"#/$defs/extensions"},
        "enabled_small":{"const":true},
        "medium_policy":{"enum":["ENABLED","DISABLED_HARD_LIMIT"]},
        "oversize_policy":{"enum":["DEFERRED","UNSUPPORTED"]},
        "corrupt_applicable":{"type":"boolean"},
        "encrypted_applicable":{"type":"boolean"},
        "minimum_samples_small":{"type":"integer","minimum":20},
        "minimum_samples_medium_or_disabled":{"type":"integer","minimum":5},
        "minimum_samples_oversize":{"type":"integer","minimum":5},
        "minimum_samples_error":{"type":"integer","minimum":10},
        "minimum_pause_sequences":{"type":"integer","minimum":20}
      },
      "allOf":[
        {
          "if":{"properties":{"medium_policy":{"const":"ENABLED"}},"required":["medium_policy"]},
          "then":{"properties":{"minimum_samples_medium_or_disabled":{"minimum":10}}},
          "else":{"properties":{"minimum_samples_medium_or_disabled":{"minimum":5}}}
        }
      ]
    },
    "unsupportedRoute":{
      "type":"object",
      "additionalProperties":false,
      "required":["route_code","route_status","extensions","unsupported_reason_code","minimum_unsupported_samples"],
      "properties":{
        "route_code":{"const":"99"},
        "route_status":{"const":"UNSUPPORTED"},
        "extensions":{"$ref":"#/$defs/extensions"},
        "unsupported_reason_code":{"const":"UNSUPPORTED_ROUTE_99"},
        "minimum_unsupported_samples":{"type":"integer","minimum":20}
      }
    }
  },
  "required":["schema_version","gate_id","plan_manifest_sha256","release_profile_path","release_profile_sha256","route_dispatch_sha256","routes","expansion_contract","expanded_test_ids"],
  "properties":{
    "schema_version":{"const":"parser-route-manifest-v2"},
    "gate_id":{"const":"G06P"},
    "plan_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "release_profile_path":{"type":"string","pattern":"^(?![A-Za-z]:)(?![/\\\\])(?!.{0,499}(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).{1,500}$"},
    "release_profile_sha256":{"$ref":"#/$defs/sha256"},
    "route_dispatch_sha256":{"$ref":"#/$defs/sha256"},
    "routes":{
      "type":"object",
      "additionalProperties":false,
      "minProperties":14,
      "maxProperties":14,
      "required":["01","02","03H","03T","04P","04D","05","06","07","08","09","10J","10X","99"],
      "properties":{
        "01":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"01"}}}]},
        "02":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"02"}}}]},
        "03H":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"03H"}}}]},
        "03T":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"03T"}}}]},
        "04P":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"04P"}}}]},
        "04D":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"04D"}}}]},
        "05":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"05"}}}]},
        "06":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"06"}}}]},
        "07":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"07"}}}]},
        "08":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"08"}}}]},
        "09":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"09"}}}]},
        "10J":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"10J"}}}]},
        "10X":{"allOf":[{"$ref":"#/$defs/supportedRoute"},{"properties":{"route_code":{"const":"10X"}}}]},
        "99":{"$ref":"#/$defs/unsupportedRoute"}
      }
    },
    "expansion_contract":{
      "type":"object",
      "additionalProperties":false,
      "required":["algorithm_id","supported_route_keys","unsupported_route_key","route_object_key_must_equal_route_code","raw_duplicate_route_keys_allowed","exact_set_equality_required","duplicates_allowed","unknown_ids_allowed","expected_count_formula","fixed_unsupported_test_id","rules"],
      "properties":{
        "algorithm_id":{"const":"PARSER_ROUTE_EXPANSION_V2"},
        "supported_route_keys":{"const":["01","02","03H","03T","04P","04D","05","06","07","08","09","10J","10X"]},
        "unsupported_route_key":{"const":"99"},
        "route_object_key_must_equal_route_code":{"const":true},
        "raw_duplicate_route_keys_allowed":{"const":false},
        "exact_set_equality_required":{"const":true},
        "duplicates_allowed":{"const":false},
        "unknown_ids_allowed":{"const":false},
        "expected_count_formula":{"const":"53+COUNT(routes[supported].medium_policy==DISABLED_HARD_LIMIT)"},
        "fixed_unsupported_test_id":{"const":"P-FMT99-U"},
        "rules":{
          "const":[
            "MEDIUM_ENABLED=>NO_TEMPLATE_ID_AND_ACTIVATE_FIXED_P-FMT<route>-M;MEDIUM_DISABLED=>P-DIS-<route>-M",
            "ALWAYS=>P-LIMIT-<route>-O",
            "CORRUPT_APPLICABLE=>P-ERR-<route>-C;ELSE=>P-NA-<route>-C",
            "ENCRYPTED_APPLICABLE=>P-ERR-<route>-E;ELSE=>P-NA-<route>-E",
            "ALWAYS=>P-PAUSE-<route>",
            "UNSUPPORTED_ROUTE_99_ALWAYS=>P-FMT99-U"
          ]
        }
      }
    },
    "expanded_test_ids":{
      "type":"array",
      "minItems":53,
      "maxItems":66,
      "uniqueItems":true,
      "contains":{"const":"P-FMT99-U"},
      "minContains":1,
      "maxContains":1,
      "items":{"type":"string","pattern":"^(?:P-FMT99-U|P-(?:DIS-(?:01|02|03H|03T|04P|04D|05|06|07|08|09|10J|10X)-M|LIMIT-(?:01|02|03H|03T|04P|04D|05|06|07|08|09|10J|10X)-O|(?:ERR|NA)-(?:01|02|03H|03T|04P|04D|05|06|07|08|09|10J|10X)-(?:C|E)|PAUSE-(?:01|02|03H|03T|04P|04D|05|06|07|08|09|10J|10X)))$"}
    }
  }
}
