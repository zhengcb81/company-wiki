{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:operation-execution-receipt:v1",
  "title": "Post-operation execution and journal receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"},
    "state": {"enum": ["PAUSED/OFF", "PAUSED/ON", "PAUSED/REGISTRY_CONFLICT", "ARMED_PRELOGIN/OFF", "ARMED_ON_PRELOGIN/ON", "LOGIN_COMMITTED/ON", "RUNNING_LOGIN_VALIDATION/ON", "LOGIN_VALIDATED_PAUSED/ON", "ENABLED_IDLE/ON", "RUNNING_AUTOSTART/ON"]}
  },
  "required": [
    "schema_version", "receipt_id", "operation_run_id", "operation_node_id", "operation_contract_sha256",
    "operation_intent_sha256", "authorization_manifest_sha256", "authorization_revalidation_receipt_sha256",
    "runtime_template_authorization_manifest_sha256", "runtime_template_authorization_revalidation_receipt_sha256",
    "runtime_template_user_approval_receipt_sha256", "g12c_rt_evidence_sha256",
    "final_activation_user_approval_receipt_sha256", "final_approval_subject_digest_sha256", "dual_approval_distinctness_verified",
    "operation_lease_receipt_sha256", "process_generation", "control_generation_before", "control_generation_after",
    "circuit_generation", "journal_manifest_sha256", "head_anchor_before_sha256", "intent_record_sha256",
    "terminal_record_type", "terminal_record_sha256", "head_anchor_after_sha256", "actual_candidate_sources_sha256",
    "actual_db_effects_sha256", "actual_file_effects_sha256", "actual_registry_effects_sha256",
    "actual_network_effects_sha256", "actual_state_effects_sha256", "budget_settlement_receipt_sha256",
    "terminal_state", "outcome", "started_at", "completed_at", "receipt_sha256", "sealed"
  ],
  "properties": {
    "schema_version": {"const": "operation-execution-receipt-v1"},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "operation_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "operation_node_id": {"type": "string", "pattern": "^OP[A-Za-z0-9-]{1,31}$"},
    "operation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "operation_intent_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_revalidation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_template_authorization_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "runtime_template_authorization_revalidation_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "runtime_template_user_approval_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "g12c_rt_evidence_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "final_activation_user_approval_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "final_approval_subject_digest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "dual_approval_distinctness_verified": {"type": "boolean"},
    "operation_lease_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "process_generation": {"type": "integer", "minimum": 0},
    "control_generation_before": {"type": "integer", "minimum": 0},
    "control_generation_after": {"type": "integer", "minimum": 0},
    "circuit_generation": {"type": "integer", "minimum": 0},
    "journal_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "head_anchor_before_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "intent_record_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "terminal_record_type": {"enum": [null, "FINALIZE", "RECONCILE"]},
    "terminal_record_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "head_anchor_after_sha256": {"$ref": "#/$defs/sha256"},
    "actual_candidate_sources_sha256": {"$ref": "#/$defs/sha256"},
    "actual_db_effects_sha256": {"$ref": "#/$defs/sha256"},
    "actual_file_effects_sha256": {"$ref": "#/$defs/sha256"},
    "actual_registry_effects_sha256": {"$ref": "#/$defs/sha256"},
    "actual_network_effects_sha256": {"$ref": "#/$defs/sha256"},
    "actual_state_effects_sha256": {"$ref": "#/$defs/sha256"},
    "budget_settlement_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "terminal_state": {"$ref": "#/$defs/state"},
    "outcome": {"enum": ["SUCCESS", "FAILURE_NO_EFFECT", "FAILURE_ROLLED_BACK", "FAILURE_SAFE_PAUSED", "RECONCILED", "UNKNOWN_EFFECT_CIRCUIT_OPEN"]},
    "started_at": {"$ref": "#/$defs/utc"},
    "completed_at": {"$ref": "#/$defs/utc"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "sealed": {"const": true}
  },
  "allOf": [
    {"if": {"properties": {"operation_node_id": {"enum": ["OP00", "OP11A"]}}, "required": ["operation_node_id"]}, "then": {"properties": {"head_anchor_before_sha256": {"type": "null"}, "intent_record_sha256": {"type": "null"}, "terminal_record_type": {"type": "null"}, "terminal_record_sha256": {"type": "null"}, "budget_settlement_receipt_sha256": {"type": "null"}}}},
    {"if": {"properties": {"operation_node_id": {"not": {"enum": ["OP00", "OP11A", "OP11J"]}}}, "required": ["operation_node_id"]}, "then": {"properties": {"head_anchor_before_sha256": {"$ref": "#/$defs/sha256"}, "intent_record_sha256": {"$ref": "#/$defs/sha256"}, "terminal_record_type": {"enum": ["FINALIZE", "RECONCILE"]}, "terminal_record_sha256": {"$ref": "#/$defs/sha256"}}}},
    {"if": {"properties": {"operation_node_id": {"const": "OP12C"}}, "required": ["operation_node_id"]}, "then": {"properties": {"runtime_template_authorization_manifest_sha256": {"$ref": "#/$defs/sha256"}, "runtime_template_authorization_revalidation_receipt_sha256": {"$ref": "#/$defs/sha256"}, "runtime_template_user_approval_receipt_sha256": {"$ref": "#/$defs/sha256"}, "g12c_rt_evidence_sha256": {"$ref": "#/$defs/sha256"}, "final_activation_user_approval_receipt_sha256": {"$ref": "#/$defs/sha256"}, "final_approval_subject_digest_sha256": {"$ref": "#/$defs/sha256"}, "dual_approval_distinctness_verified": {"const": true}}}},
    {"if": {"properties": {"operation_node_id": {"const": "OP-RUNTIME-CYCLE"}}, "required": ["operation_node_id"]}, "then": {"properties": {"runtime_template_authorization_manifest_sha256": {"$ref": "#/$defs/sha256"}, "runtime_template_authorization_revalidation_receipt_sha256": {"$ref": "#/$defs/sha256"}, "runtime_template_user_approval_receipt_sha256": {"$ref": "#/$defs/sha256"}, "g12c_rt_evidence_sha256": {"$ref": "#/$defs/sha256"}, "final_activation_user_approval_receipt_sha256": {"type": "null"}, "final_approval_subject_digest_sha256": {"type": "null"}, "dual_approval_distinctness_verified": {"const": false}}}},
    {"if": {"properties": {"operation_node_id": {"not": {"enum": ["OP12C", "OP-RUNTIME-CYCLE"]}}}, "required": ["operation_node_id"]}, "then": {"properties": {"runtime_template_authorization_manifest_sha256": {"type": "null"}, "runtime_template_authorization_revalidation_receipt_sha256": {"type": "null"}, "runtime_template_user_approval_receipt_sha256": {"type": "null"}, "g12c_rt_evidence_sha256": {"type": "null"}, "final_activation_user_approval_receipt_sha256": {"type": "null"}, "final_approval_subject_digest_sha256": {"type": "null"}, "dual_approval_distinctness_verified": {"const": false}}}}
  ],
  "x-semantic-rules": [
    "receipt_sha256 hashes RFC 8785 canonical bytes excluding only receipt_sha256. started_at <= completed_at and all referenced authorization, journal and lease artifacts were current throughout the effect window.",
    "The receipt is produced only after the terminal journal record and head anchor are durable. Neither the operation contract nor journal records reference this future receipt, so the hash dependency graph is acyclic.",
    "All actual effect digests are computed from post-read observations and equal or are strict subsets of the sealed contract commitments. Any extra effect, missing evidence or ambiguous outcome fails closed and opens the circuit.",
    "For OP-RUNTIME-CYCLE or any network egress, budget_settlement_receipt_sha256 is mandatory and reconciles the exact atomic reservation bundle. For no-egress operations it is null unless the contract explicitly carries a no-egress snapshot receipt.",
    "OP12C records both purpose-bound user approval receipt hashes, both authorization branches and G12C-RT evidence, with pairwise-distinct approval identities verified. OP-RUNTIME-CYCLE records only the already approved runtime-template branch. These values equal the sealed operation contract and evidence manifest; any mismatch makes the receipt invalid."
  ]
}
