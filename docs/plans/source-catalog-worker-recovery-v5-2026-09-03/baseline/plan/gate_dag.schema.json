{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:company-wiki:source-catalog-worker-recovery:gate-dag-instance:v4",
  "title":"Machine Gate DAG instance schema",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "id":{"type":"string","minLength":2,"maxLength":64},
    "role":{"enum":["design_correctness","test_correctness","ledger_schema","dag_adversarial","sql_performance","control_security","test_operations","data_integrity","runtime_operations","storage_recovery","llm_data_governance","windows_startup","release_security","rollback_operations","parser_performance","scanner_performance","evidence_privacy"]},
    "rolePolicy":{
      "type":"object","additionalProperties":false,"required":["roles"],
      "properties":{
        "roles":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/role"}},
        "disjoint_from":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "min_not_in":{"type":"object","additionalProperties":false,"required":["count","nodes"],"properties":{"count":{"type":"integer","minimum":1,"maximum":3},"nodes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}}
      }
    },
    "familyRolePolicy":{
      "type":"object","additionalProperties":false,"required":["D","G","post_disjoint_from_pre"],
      "properties":{"D":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/role"}},"G":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/role"}},"post_disjoint_from_pre":{"const":true}}
    },
    "decisionCondition":{
      "type":"object","additionalProperties":false,
      "required":["id","equals"],
      "properties":{"id":{"enum":["ADR-02","ADR-11","ADR-13"]},"equals":{"enum":["NO_INDEX","INDEX","LLM_OFF","LLM_ENABLED","NO_SCHEMA_DELTA","SCHEMA_DELTA"]}}
    },
    "allExpr":{
      "type":"object","additionalProperties":false,"required":["all"],
      "properties":{"all":{"type":"array","items":{"$ref":"#/$defs/id"}},"decision":{"$ref":"#/$defs/decisionCondition"}}
    },
    "requires":{
      "type":"object","additionalProperties":false,
      "properties":{
        "all":{"type":"array","items":{"$ref":"#/$defs/id"}},
        "any":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/allExpr"}},
        "exactly_one":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/id"}},
        "decision":{"$ref":"#/$defs/decisionCondition"},
        "external":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"}},
        "conditional":{
          "type":"array","items":{
            "type":"object","additionalProperties":false,"required":["if","then_all"],
            "properties":{
              "if":{"type":"object","additionalProperties":false,"required":["decision"],"properties":{"decision":{"$ref":"#/$defs/decisionCondition"}}},
              "then_all":{"type":"array","items":{"$ref":"#/$defs/id"}},
              "then_family_all":{
                "type":"object","additionalProperties":false,
                "required":["family","instance_source","allow_zero","contiguous_from"],
                "properties":{"family":{"type":"string"},"instance_source":{"type":"string"},"allow_zero":{"type":"boolean"},"contiguous_from":{"type":"integer","minimum":1}}
              }
            }
          }
        }
      },
      "anyOf":[{"required":["all"]},{"required":["any"]}]
    },
    "node":{
      "type":"object","additionalProperties":false,
      "required":["id","type","requires","reviewers_on_pass"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "type":{"enum":["T","D","I","OP","G"]},
        "requires":{"$ref":"#/$defs/requires"},
        "reviewers_on_pass":{"type":"integer","minimum":0,"maximum":3},
        "decision":{"enum":["ADR-02","ADR-11","ADR-13"]},
        "only_successor":{"$ref":"#/$defs/id"},
        "operation":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"},
        "pass_production_state":{"type":"string","minLength":3,"maxLength":80},
        "pass_production_state_source":{"enum":["BOUND_OPERATION_TERMINAL_STATE"]},
        "pass_lifecycle_outcome":{"type":"string","minLength":3,"maxLength":80},
        "terminal_on_pass":{"type":"boolean"},
        "reviewer_disjoint_from":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "required_reviewer_roles":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]+$"}},
        "min_reviewers_not_in_nodes":{
          "type":"object","additionalProperties":false,"required":["count","nodes"],
          "properties":{"count":{"type":"integer","minimum":1,"maximum":3},"nodes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}
        },
        "failure_successors":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "optional_external_successor":{
          "type":"object","additionalProperties":false,"required":["node","external","absence_state","absence_is_blocked"],
          "properties":{"node":{"$ref":"#/$defs/id"},"external":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},"absence_state":{"type":"string","minLength":3},"absence_is_blocked":{"const":false}}
        }
      },
      "allOf":[
        {"if":{"properties":{"type":{"const":"OP"}},"required":["type"]},"then":{"required":["operation"],"properties":{"reviewers_on_pass":{"const":0}}}},
        {"if":{"properties":{"type":{"enum":["T","I"]}},"required":["type"]},"then":{"properties":{"reviewers_on_pass":{"const":0}}}},
        {"if":{"properties":{"type":{"enum":["D","G"]}},"required":["type"]},"then":{"properties":{"reviewers_on_pass":{"minimum":1}}}}
      ]
    }
  },
  "required":["schema_id","contract","plan_revision","entry_node","pass_statuses","terminal_failure_statuses","operation_policy_catalog","reviewer_rules","branch_decisions","nodes","families","global_invariants"],
  "properties":{
    "schema_id":{"const":"urn:company-wiki:source-catalog-worker-recovery:gate-dag-instance:v4"},
    "contract":{"const":"source-catalog-worker-recovery-gate-dag"},
    "plan_revision":{"const":"v4"},
    "entry_node":{"const":"T00L"},
    "pass_statuses":{"const":["PASSED","PASSED_WITH_P2"]},
    "terminal_failure_statuses":{"const":["BLOCKED","INVALIDATED"]},
    "operation_policy_catalog":{"const":"operation_contracts.v4.json"},
    "reviewer_rules":{
      "type":"object","additionalProperties":false,
      "required":["reviewers_are_read_only","distinct_agent_ids","distinct_roles","exclude_implementer_and_operator","storage_hash_confirmation_required","review_payload_schema","review_confirmation_schema","allowed_roles","default_roles_on_pass","node_role_overrides","family_role_overrides"],
      "properties":{
        "reviewers_are_read_only":{"const":true},
        "distinct_agent_ids":{"const":true},
        "distinct_roles":{"const":true},
        "exclude_implementer_and_operator":{"const":true},
        "storage_hash_confirmation_required":{"const":true},
        "review_payload_schema":{"const":"review_result.schema.json"},
        "review_confirmation_schema":{"const":"review_confirmation.schema.json"},
        "allowed_roles":{"type":"array","minItems":17,"maxItems":17,"uniqueItems":true,"items":{"$ref":"#/$defs/role"}},
        "default_roles_on_pass":{"type":"object","additionalProperties":false,"required":["D","G"],"properties":{"D":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/role"}},"G":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/role"}}}},
        "node_role_overrides":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/rolePolicy"}},
        "family_role_overrides":{"type":"object","additionalProperties":false,"required":["G11B-BFnn","05Rnn"],"properties":{"G11B-BFnn":{"$ref":"#/$defs/familyRolePolicy"},"05Rnn":{"$ref":"#/$defs/familyRolePolicy"}}}
      }
    },
    "branch_decisions":{
      "type":"object","required":["ADR-02","ADR-11","ADR-13"],"additionalProperties":false,
      "properties":{
        "ADR-02":{
          "type":"object","additionalProperties":false,
          "required":["node","allowed_values","exactly_one","query_acceptance_contract"],
          "properties":{
            "node":{"const":"G02B-ADR"},"allowed_values":{"const":["NO_INDEX","INDEX"]},"exactly_one":{"const":true},
            "query_acceptance_contract":{
              "type":"object","additionalProperties":false,
              "required":["pre_migration_gate","no_index_required_outcome","index_allowed_outcome","index_allowed_only_if","post_migration_gate","post_migration_required_outcome","deadline_seconds"],
              "properties":{
                "pre_migration_gate":{"const":"G11A"},
                "no_index_required_outcome":{"const":"QUERY_BUDGET_MET"},
                "index_allowed_outcome":{"const":"INDEX_REQUIRED"},
                "index_allowed_only_if":{"const":["SEMANTIC_ORACLE_MATCH","BOUNDED_READ_ONLY_DIAGNOSTIC","QUERY_PLAN_PROVES_INDEX_REQUIRED","NO_PRODUCTION_MUTATION"]},
                "post_migration_gate":{"const":"G11M"},
                "post_migration_required_outcome":{"const":"QUERY_BUDGET_MET"},
                "deadline_seconds":{"const":10}
              }
            }
          }
        },
        "ADR-11":{"type":"object","additionalProperties":false,"required":["node","allowed_values","exactly_one"],"properties":{"node":{"const":"G07-ADR"},"allowed_values":{"const":["LLM_OFF","LLM_ENABLED"]},"exactly_one":{"const":true}}},
        "ADR-13":{"type":"object","additionalProperties":false,"required":["node","allowed_values","exactly_one"],"properties":{"node":{"const":"G11M-L-ADR"},"allowed_values":{"const":["NO_SCHEMA_DELTA","SCHEMA_DELTA"]},"exactly_one":{"const":true}}}
      }
    },
    "nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}},
    "families":{"type":"object","minProperties":1},
    "global_invariants":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"}}
  }
}
