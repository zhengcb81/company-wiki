      },
      "allOf": [
        {"if": {"properties": {"policy": {"const": "NOT_APPLICABLE"}}, "required": ["policy"]}, "then": {"properties": {"journal_manifest_path": {"type": "null"}, "journal_manifest_sha256": {"type": "null"}, "head_anchor_before_path": {"type": "null"}, "head_anchor_before_sha256": {"type": "null"}, "intent_record_path": {"type": "null"}, "intent_record_sha256": {"type": "null"}, "terminal_record_type": {"type": "null"}, "terminal_record_path": {"type": "null"}, "terminal_record_sha256": {"type": "null"}, "head_anchor_after_path": {"type": "null"}, "head_anchor_after_sha256": {"type": "null"}, "execution_receipt_path": {"type": "null"}, "execution_receipt_sha256": {"type": "null"}}}},
        {"if": {"properties": {"policy": {"const": "INITIALIZE"}}, "required": ["policy"]}, "then": {"properties": {"journal_manifest_path": {"type": "string"}, "journal_manifest_sha256": {"$ref": "#/$defs/sha256"}, "head_anchor_before_path": {"type": "null"}, "head_anchor_before_sha256": {"type": "null"}, "intent_record_path": {"type": "null"}, "intent_record_sha256": {"type": "null"}, "terminal_record_type": {"type": "null"}, "terminal_record_path": {"type": "null"}, "terminal_record_sha256": {"type": "null"}, "head_anchor_after_path": {"type": "string"}, "head_anchor_after_sha256": {"$ref": "#/$defs/sha256"}, "execution_receipt_path": {"type": "string"}, "execution_receipt_sha256": {"$ref": "#/$defs/sha256"}}}},
        {"if": {"properties": {"policy": {"const": "REQUIRED_INTENT_FINALIZE"}}, "required": ["policy"]}, "then": {"properties": {"journal_manifest_path": {"type": "string"}, "journal_manifest_sha256": {"$ref": "#/$defs/sha256"}, "head_anchor_before_path": {"type": "string"}, "head_anchor_before_sha256": {"$ref": "#/$defs/sha256"}, "intent_record_path": {"type": "string"}, "intent_record_sha256": {"$ref": "#/$defs/sha256"}, "terminal_record_type": {"enum": ["FINALIZE", "RECONCILE"]}, "terminal_record_path": {"type": "string"}, "terminal_record_sha256": {"$ref": "#/$defs/sha256"}, "head_anchor_after_path": {"type": "string"}, "head_anchor_after_sha256": {"$ref": "#/$defs/sha256"}, "execution_receipt_path": {"type": "string"}, "execution_receipt_sha256": {"$ref": "#/$defs/sha256"}}}}
