    },
    "nodeId": {
      "type": "string",
      "pattern": "^(T00L|D00L|I00L|G00L|D00|OP00|G00|T01|D01|G01|T02A|D02A|I02A|G02A|G02B-ADR|(T|D|I|G)02B-(NI|IDX)|(T|D|I|G)(03|04|05|06|06P|07E|07O|08|09P|09)|G07-ADR|G10C|D11A|OP11A|G11A|D11M|OP11M|G11M|D11J|OP11J|G11J|G11M-L-ADR|D11M-L|OP11M-L|G11M-L|(D|OP|G)11B-A[123]|(D|OP|G)11B-BP|(D|OP|G)11B-BF(0[1-9]|[1-9][0-9])|G10R|D12A|OP12A|G12A|G12B-PRE|D12B-ARM|OP12B-ARM|G12B-ARM|D12B-RB|OP12B-RB|G12B-RB|D12B-CAS|OP12B-CAS|G12B-CAS|D12B-LOGIN|OP12B-LOGIN|G12B-POST|D12C-RT|G12C-RT|D12C|G12C-PRE|OP12C|G12C|OP12C-RB|G12C-RB|OP-RUNTIME-CYCLE|(D|OP|G)05R(0[1-9]|[1-9][0-9]))$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "artifact_type", "storage_kind", "repo_relative_path", "opaque_sink_id", "sink_object_id",
        "digest_kind", "digest", "hmac_key_id", "size_bytes", "media_type", "sensitivity",
        "acl_snapshot_sha256", "file_identity_sha256", "volume_identity_sha256", "retention_policy_sha256", "encryption", "reparse_point_observed", "created_at", "expires_at",
        "contains_secret", "producer_identity_sha256"
