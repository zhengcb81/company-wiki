        "final_activation_authorization_revalidation_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "final_activation_user_approval_receipt_path": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^evidence/[A-Za-z0-9][A-Za-z0-9._-]*/final_activation_user_approval_receipt\\.json$"}]},
