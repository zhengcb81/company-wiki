{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:validator-scenario-fixture:v1",
  "title": "Composite hermetic validator scenario fixture",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"},
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["member_id", "role", "fixture_relative_path", "schema_id", "sha256", "size_bytes", "media_type", "mutable_by_vector"],
      "properties": {
        "member_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "role": {"enum": ["GATE_LEDGER", "GATE_LEDGER_TRANSCRIPT", "VALIDATOR_REQUEST", "GATE_DAG", "GATE_LEDGER_SCHEMA", "OPERATION_CATALOG", "OPERATION_CONTRACT", "OPERATION_INTENT", "OPERATION_INTENT_TEMPLATE", "RUNTIME_AUTHORIZATION", "FINAL_ACTIVATION_AUTHORIZATION", "RUNTIME_AUTH_REVALIDATION_RECEIPT", "FINAL_AUTH_REVALIDATION_RECEIPT", "RUNTIME_TEMPLATE_USER_APPROVAL_RECEIPT", "FINAL_ACTIVATION_USER_APPROVAL_RECEIPT", "AUTHORIZATION", "AUTH_REVALIDATION_RECEIPT", "EVIDENCE_MANIFEST", "REVIEW_RESULT", "REVIEW_CONFIRMATION", "BOOTSTRAP_MANIFEST", "BOOTSTRAP_RECEIPT", "VALIDATOR_RELEASE", "SCHEMA_REGISTRY", "JOURNAL_MANIFEST", "JOURNAL_HEAD_ANCHOR_BEFORE", "JOURNAL_RECORD_INTENT", "JOURNAL_RECORD_TERMINAL", "JOURNAL_HEAD_ANCHOR_AFTER", "OPERATION_EXECUTION_RECEIPT", "BUDGET_RESERVATION_BUNDLE", "BUDGET_SETTLEMENT_RECEIPT", "OPAQUE_ROOT_CATALOG", "EVIDENCE_SINK_CATALOG", "CLOCK_FIXTURE", "OTHER_TYPED_ATTACHMENT"]},
        "fixture_relative_path": {"type": "string", "pattern": "^scenario/[A-Za-z0-9][A-Za-z0-9._-]{0,99}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,99})*$"},
        "schema_id": {"type": "string", "pattern": "^urn:company-wiki:source-catalog-worker-recovery:[a-z0-9-]+:v[1-9][0-9]*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 2},
        "media_type": {"const": "application/json"},
        "mutable_by_vector": {"type": "boolean"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["mutation_id", "target_member_id", "json_pointer", "operator", "value", "pointer_must_exist_before", "expected_json_type_before", "derived_recompute_member_ids", "intentionally_stale_member_ids", "recompute_order", "expected_primary_code", "expected_stage", "expected_pointer"],
      "properties": {
        "mutation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "target_member_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "json_pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"},
        "operator": {"enum": ["SET", "DELETE", "INSERT_ARRAY", "APPEND_ARRAY", "DUPLICATE_ARRAY_ITEM", "TRUNCATE_UTF8_BYTES", "REPLACE_RAW_BYTES"]},
        "value": {},
        "pointer_must_exist_before": {"const": true},
        "expected_json_type_before": {"enum": ["object", "array", "string", "number", "integer", "boolean", "null"]},
        "derived_recompute_member_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 160}},
        "intentionally_stale_member_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 160}},
        "recompute_order": {"type": "array", "uniqueItems": true, "items": {"enum": ["CANONICAL_MEMBER_HASHES", "INTERNAL_RECORD_HASHES", "CHAIN_LINKS", "HEAD_ANCHORS", "TREE_ROOT", "CLI_EXPECTED_HASHES"]}},
        "expected_primary_code": {"type": "string", "pattern": "^GLV-E[0-9]{3}$"},
        "expected_stage": {"type": "string", "minLength": 2, "maxLength": 80},
        "expected_pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"}
      }
    }
  },
  "required": ["schema_version", "scenario_id", "scenario_kind", "virtual_root_id", "plan_manifest_sha256", "validator_release_manifest_sha256", "schema_registry_sha256", "fixture_clock_utc", "external_head_anchor_member_id", "members", "tree_root_sha256", "cli_arguments", "mutations", "base_scenario_expected_result", "production_path_access_forbidden", "sealed"],
  "properties": {
    "schema_version": {"const": "validator-scenario-fixture-v1"},
    "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "scenario_kind": {"enum": ["SINGLE_ARTIFACT", "LEDGER_TRANSCRIPT", "BOOTSTRAP_TRANSCRIPT", "OPERATION_BUNDLE", "JOURNAL_RECOVERY", "RUNTIME_CYCLE"]},
    "virtual_root_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "validator_release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "schema_registry_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_clock_utc": {"$ref": "#/$defs/utc"},
    "external_head_anchor_member_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 8, "maxLength": 160}]},
    "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
    "tree_root_sha256": {"$ref": "#/$defs/sha256"},
    "cli_arguments": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^--[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 240}},
    "mutations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/mutation"}},
    "base_scenario_expected_result": {"const": "OK"},
    "production_path_access_forbidden": {"const": true},
    "sealed": {"const": true}
  },
  "x-semantic-rules": [
    "Member IDs, roles requiring singleton identity, schema IDs and Windows-case-folded paths are unique. Every member validates against its registered exact schema before any mutation and the unmodified scenario must return OK.",
    "Scenario-kind role requirements are closed: ledger transcript includes VALIDATOR_REQUEST/GATE_LEDGER_TRANSCRIPT/DAG/schema/anchor/reviews/evidence; bootstrap includes manifest/receipt/release; ordinary operation bundle includes intent/auth/revalidation/contract/evidence. The final-activation bundle includes two purpose-specific authorization roles, two revalidation roles, two user-approval-receipt roles, and G12C-RT evidence. Journal recovery includes manifest/anchors/records/receipt; runtime cycle additionally includes the runtime template approval chain and budget artifacts.",
    "Each mutation target member exists, is mutable_by_vector, its pointer exists with the declared pre-type, and the operator is type-compatible. Missing or stale pointers fail fixture construction, not validator execution.",
    "Derived recomputation is explicit and topologically ordered. The two member-ID sets are disjoint and cover every affected derived hash/link/anchor/tree/CLI value. Any undeclared recomputation or accidental earlier error fails fixture construction.",
    "After materialization, the validator's actual primary code, stage and pointer equal the mutation declaration exactly. Duplicate scenarios or vectors with identical final tree roots are rejected.",
    "All files live under a newly created empty tmp root and use virtual path IDs; production DB, registry, process, source, config, journal, budget store and network access are denied and audited."
  ]
}
