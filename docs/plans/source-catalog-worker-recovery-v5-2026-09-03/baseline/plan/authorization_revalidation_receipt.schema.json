{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-wiki:source-catalog-worker-recovery:authorization-revalidation-receipt:v1",
  "title": "Fresh authoritative authorization revalidation receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "authorization_id", "authorization_manifest_sha256", "status"],
      "properties": {
        "role": {"enum": ["PRIMARY", "PARENT"]},
        "authorization_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
        "authorization_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["VALID_NOT_REVOKED", "SYSTEM_POLICY_VALID"]}
      }
    }
  },
  "required": ["schema_version", "receipt_id", "authorization_kind", "subjects", "compensation_grant_id", "compensation_grant_sha256", "revocation_authority_id", "revocation_anchor_path_id", "revocation_anchor_generation", "revocation_anchor_sha256", "checked_at", "valid_until", "maximum_age_seconds", "overall_status", "checker_release_sha256", "offline_or_error_policy", "receipt_sha256", "sealed"],
  "properties": {
    "schema_version": {"const": "authorization-revalidation-receipt-v1"},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "authorization_kind": {"enum": ["NOT_APPLICABLE_LOCAL_READ_ONLY", "STAGE_BOUND_OPERATION", "BOUND_COMPENSATION", "CIRCUIT_RESET"]},
    "subjects": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/subject"}, "contains": {"properties": {"role": {"const": "PRIMARY"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
    "compensation_grant_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"}]},
    "compensation_grant_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "revocation_authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$"},
    "revocation_anchor_path_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"},
    "revocation_anchor_generation": {"type": "integer", "minimum": 0},
    "revocation_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "checked_at": {"$ref": "#/$defs/utc"},
    "valid_until": {"$ref": "#/$defs/utc"},
    "maximum_age_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "overall_status": {"enum": ["VALID_NOT_REVOKED", "SYSTEM_POLICY_VALID"]},
    "checker_release_sha256": {"$ref": "#/$defs/sha256"},
    "offline_or_error_policy": {"const": "FAIL_CLOSED_NO_SIDE_EFFECT"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "sealed": {"const": true}
  },
  "allOf": [
    {"if": {"properties": {"authorization_kind": {"const": "BOUND_COMPENSATION"}}, "required": ["authorization_kind"]}, "then": {"properties": {"subjects": {"minItems": 2, "maxItems": 2, "contains": {"properties": {"role": {"const": "PARENT"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}, "compensation_grant_id": {"type": "string"}, "compensation_grant_sha256": {"$ref": "#/$defs/sha256"}}}},
    {"if": {"properties": {"authorization_kind": {"not": {"const": "BOUND_COMPENSATION"}}}, "required": ["authorization_kind"]}, "then": {"properties": {"subjects": {"minItems": 1, "maxItems": 1}, "compensation_grant_id": {"type": "null"}, "compensation_grant_sha256": {"type": "null"}}}}
  ],
  "x-semantic-rules": [
    "receipt_sha256 hashes RFC 8785 canonical bytes excluding only receipt_sha256. checked_at < valid_until and valid_until - checked_at <= maximum_age_seconds.",
    "revocation authority ID/path, anchor generation/hash, maximum age and checker release exactly equal the frozen authorization policy; callers cannot choose a different source or extend freshness.",
    "PRIMARY equals the operation contract authorization. For BOUND_COMPENSATION, PARENT and compensation grant equal the child manifest parent bindings and all three remain current; revoking any one blocks compensation before side effects.",
    "The checker reads the protected anchor itself. Offline, missing, stale, ahead/behind, ACL-drifted, unknown or error status produces no receipt and fails closed."
  ]
}
