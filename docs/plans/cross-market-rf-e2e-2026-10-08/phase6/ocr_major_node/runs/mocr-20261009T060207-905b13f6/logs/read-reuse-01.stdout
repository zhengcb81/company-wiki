company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:bb9a42e4853a36a117a32a3ed8374261cf3ceba97ef348c9c1af36e146b585c1"],"modality":"planned","needs_review":true,"text":"Linkedln Marketing Solutions and Premium Subscriptions will now be reported in the Search and advertising revenue (ex TAC) growth metric."},{"claim_id":"c4","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:10c4910f7f75f25b8bd8545821b965b3969079fc1c563ce9fe6e7cd0ef471f9e"],"modality":"planned","needs_review":true,"text":"Devices and Consumer will include Windows, XBOX, and advertising businesses."},{"claim_id":"c5","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:f458635ae94649ef04c9212054e0ba985009b288271b3b3de0e78058c61ceb42"],"modality":"actual","needs_review":true,"text":"Microsoft 365 consumer cloud is unchanged."},{"claim_id":"c6","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:552850b1d9626d8ec5043f92fe4c372f7f87666ac4010a533a3a1585affb590f"],"modality":"actual","needs_review":true,"text":"Server products now excludes the on-premises portion of GitHub and other developer services."},{"claim_id":"c7","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:423f3399be38c16eb3cda81a2b4cdb6caee4c9b2961e5b1b8f92665b220f4df8","urn:company-wiki:evidence-span:sha256:81b6516b985e6322ac9e996aab23be814211b93461cb898032af3b2e7db7f062"],"modality":"planned","needs_review":true,"text":"Microsoft 365 commercial products will now include the on-premises portion of GitHub and other developer services previously reported in Server products."},{"claim_id":"c8","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:dacf2cfb031f6d67692c13f49835a61481f633d9d82ad82bd2989fe2a7aa37c1"],"modality":"actual","needs_review":true,"text":"The on-premises portion of the Healthcare and Life Sciences business moved to Industry Solutions."},{"claim_id":"c9","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:b81149cc5ae6e796a77ab50a9698c06eb4efae59ed957d7c4409cb04a48609b3"],"modality":"actual","needs_review":true,"text":"Microsoft 365 consumer products was previously reported as Office consumer products, but is otherwise unchanged."},{"claim_id":"c10","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:3c57f11bd19455f3f4960aef45753de6f4ece6c3dba8b76ab59876060ca048ae"],"modality":"actual","needs_review":true,"text":"Frontier and support services was previously reported as Enterprise and Partner services, but is otherwise unchanged."},{"claim_id":"c11","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:824ae16409773e70fbce8e7ef509f3782bd5d707ad729d3813091a0f0b50c7fa","urn:company-wiki:evidence-span:sha256:e25c6165d78f9bb8df1e4ce1045761b1535effdb7e5c2b022d60cc568fb10741"],"modality":"actual","needs_review":true,"text":"The company is updating product and services reporting definitions to provide transparency to investors and better represent the businesses as managed today."},{"claim_id":"c12","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:38122e3114d7b95929709ffdeef183ca9b23ef89e1fd0dadd48d7592f20c5508","urn:company-wiki:evidence-span:sha256:e25c6165d78f9bb8df1e4ce1045761b1535effdb7e5c2b022d60cc568fb10741"],"modality":"planned","needs_review":true,"text":"The referenced product and service offerings will be reported in SEC filings, and the updated definitions will be used in SEC filings going forward."},{"claim_id":"c13","claim_type":"company_statement","evidence_ids":["urn:company-wiki:evidence-span:sha256:2dffff9465922346c0f799db12ed4b1ff4dc66b7fbe61153bddc48614b4cb700","urn:company-wiki:evidence-span:sha256:58dc15af83cb1dc84818a4bbee4b5494760b3ff0d01ebaaf259e5ea055a1fa4b"],"modality":"planned","needs_review":true,"text":"Microsoft 365 commercial cloud will now include GitHub cloud and other developer cloud services as well as Security Copilot, which were previously reported in Azure."}],"language":"en","source_id":"urn:company-wiki:source:sha256:c02f4ea1a2719b74d5752559ad7b907d89dd4b47d292424ade8988396fb2dcd4","source_sha256":"c02f4ea1a2719b74d5752559ad7b907d89dd4b47d292424ade8988396fb2dcd4","status":"needs_review"},"model":{"adapter_id":"openai-compatible-http/1","model_id":"deepseek-flash","prompt_version":"1.6.0","response_sha256":"5dba6e735e34b238ef0c72fb8ab544306952aed21a852af18731ca6c95244e2d"},"status":"completed","translate":false},"transcript_byte_bindings":[],"transcript_lineage":null,"versions":{"bundle_producer":"1.0.0","material":null,"model":"deepseek-flash","parser":"2.0.0","prompt":"1.6.0","selector":"0.5.0"}}