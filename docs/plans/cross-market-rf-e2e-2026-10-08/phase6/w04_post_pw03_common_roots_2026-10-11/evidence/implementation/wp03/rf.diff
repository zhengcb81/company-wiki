+def _locale_family(declared: str) -> str:
+    match = re.fullmatch(r"(zh|en)(?:-(Hans|Hant|Latn))?(?:-([a-z]{2}|[0-9]{3}))?", declared, re.IGNORECASE)
+    _require(match is not None, "invalid_declared_language")
+    family, script, _region = match.groups()
+    family = family.lower()
