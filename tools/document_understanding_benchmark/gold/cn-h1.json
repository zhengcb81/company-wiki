      "any_support_sets": [
        [
          {
            "page": 13,
            "exact_quote": "未来五年，公司将通过自主开发与外延并购，覆盖60%以上的集成电路高端设备市场和70%以上的先进封装设备市场",
            "locator": "loc:v1/page:13/paragraph:4"
          }
        ]
      ],
      "must_preserve": [
        "未来五年",
        "60%",
        "70%"
