{
  "schema_version": 1,
  "id": "RR-11.4",
  "implementer_id": "root-current-task",
  "acceptance": "control/acceptance.json",
  "acceptance_lock": "control/acceptance.lock.json",
  "baseline_snapshot": "artifacts/gates/rr-11.4-validation-baseline.json",
  "allowed_paths": [
    "artifacts/gates/**"
  ],
  "invariants": [
    "The audit contains no secret value field or plaintext credential.",
    "Current tracked active secret candidates equal zero.",
    "Historical and local-env evidence cannot be marked remediated without external proof.",
    "Remote-ref evidence upgrades history rewrite to authorization pending.",
    "Production data and Git index remain unchanged."
  ],
  "commands": [
    {
      "name": "acceptance-lock",
      "argv": [
        "python",
        "scripts/gate_runner.py",
        "verify-lock",
        "--root",
        ".",
        "--lock",
        "control/acceptance.lock.json"
      ],
      "timeout_s": 60
    },
    {
      "name": "secret-decision-verify",
      "argv": [
        "python",
        "scripts/secret_audit.py",
        "verify",
        "--root",
        ".",
        "--audit",
        "artifacts/security/secret-decision.json",
        "--local-env",
        ".env"
      ],
      "timeout_s": 180
    },
    {
      "name": "secret-and-freeze-contracts",
      "argv": [
        "python",
        "-m",
        "pytest",
        "tests/unit/test_secret_audit.py",
        "tests/unit/test_writer_freeze.py",
        "tests/unit/test_gate_runner.py",
        "-q"
      ],
      "timeout_s": 180
    },
    {
      "name": "full-local-suite",
      "argv": [
        "python",
        "-m",
        "pytest",
        "-q"
      ],
      "timeout_s": 300
    }
  ]
}
