  "invariants": [
    {
      "id": "raw-immutability",
      "description": "Ingest, cleanup and migration never modify or delete raw sources without an approved manifest.",
      "observable": "before/after raw manifest is byte-identical"
    },
    {
      "id": "evidence-conservation",
      "description": "Every active factual claim has a resolvable source revision and evidence locator.",
      "observable": "active factual evidence coverage equals 1.0"
    },
    {
      "id": "commit-conservation",
      "description": "Accepted patch, claims, answers and per-target outbox are committed in one transaction.",
      "observable": "crash injection never exposes a completed source with incomplete hidden delivery"
    },
    {
      "id": "projection-determinism",
      "description": "The same accepted ledger and template version produce identical bytes across dates and machines.",
      "observable": "rebuild SHA-256 is identical"
    },
    {
      "id": "propagation-conservation",
      "description": "Company, sector and theme targets are independently idempotent and recoverable.",
      "observable": "partial target failure only retries incomplete deliveries"
    },
    {
      "id": "control-conservation",
      "description": "Budget, write mode, kill switch and review decisions control the real production writers.",
      "observable": "fault drills stop or resume the canonical production entrypoint"
    },
    {
      "id": "reproducibility",
      "description": "A clean clone can install, test and rebuild projections without local raw, network or real LLM.",
      "observable": "clean environment gate receipt passes"
    }
  ],
