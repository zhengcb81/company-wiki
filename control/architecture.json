{
  "schema_version": 1,
  "rules": [
    {
      "id": "configured-batch-uses-project-loader",
      "kind": "required_regex",
      "glob": "scripts/narrative_batch_configured.py",
      "regex": "Config\\.load\\(",
      "message": "configured batch must use the project's Config loader"
    },
    {
      "id": "configured-batch-uses-finite-runtime",
      "kind": "required_regex",
      "glob": "scripts/narrative_batch_configured.py",
      "regex": "from\\s+company_wiki\\.automation\\.narrative_batch_cli\\s+import\\s+main",
      "message": "configured batch must delegate to the finite runtime"
    },
    {
      "id": "source-layer-does-not-import-downstream",
      "kind": "forbidden_regex",
      "glob": "src/company_wiki/source_catalog/**/*.py",
      "regex": "(?:from|import)\\s+(?:[Ss]tock[Ww]iki|revenue_forecast|invest_[A-Za-z_]+)(?:\\.|\\s|$)",
      "message": "source layer must not depend on downstream research implementation"
    }
  ]
}
